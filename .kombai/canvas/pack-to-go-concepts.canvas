      CATEGORY DISTRIBUTION\n                        </div>\n                        <div class=\"text-[11px]\" data-kid=\"1-2-4-2-2-4-2\" data-name=\"distribution items\">\n                            <div class=\"grid grid-cols-[1fr_auto_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-4-2-1\" data-name=\"category row 1\">\n                                <span data-kid=\"1-2-4-2-2-4-2-1-1\" data-name=\"category 1 name\">\n                                    숙박\n                                </span>\n                                <span data-kid=\"1-2-4-2-2-4-2-1-2\" data-name=\"category 1 value\">\n                                    2,000,000원\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-4-2-2-4-2-1-3\" data-name=\"category 1 percentage\">\n                                    35%\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-4-2-2\" data-name=\"category row 2\">\n                                <span data-kid=\"1-2-4-2-2-4-2-2-1\" data-name=\"category 2 name\">\n                                    항공\n                                </span>\n                                <span data-kid=\"1-2-4-2-2-4-2-2-2\" data-name=\"category 2 value\">\n                                    1,500,000원\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-4-2-2-4-2-2-3\" data-name=\"category 2 percentage\">\n                                    26%\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-4-2-3\" data-name=\"category row 3\">\n                                <span data-kid=\"1-2-4-2-2-4-2-3-1\" data-name=\"category 3 name\">\n                                    식비\n                                </span>\n                                <span data-kid=\"1-2-4-2-2-4-2-3-2\" data-name=\"category 3 value\">\n                                    1,200,000원\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-4-2-2-4-2-3-3\" data-name=\"category 3 percentage\">\n                                    21%\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-4-2-4\" data-name=\"category row 4\">\n                                <span data-kid=\"1-2-4-2-2-4-2-4-1\" data-name=\"category 4 name\">\n                                    교통\n                                </span>\n                                <span data-kid=\"1-2-4-2-2-4-2-4-2\" data-name=\"category 4 value\">\n                                    400,000원\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-4-2-2-4-2-4-3\" data-name=\"category 4 percentage\">\n                                    7%\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-4-2-5\" data-name=\"category row 5\">\n                                <span data-kid=\"1-2-4-2-2-4-2-5-1\" data-name=\"category 5 name\">\n                                    액티비티\n                                </span>\n                                <span data-kid=\"1-2-4-2-2-4-2-5-2\" data-name=\"category 5 value\">\n                                    300,000원\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-4-2-2-4-2-5-3\" data-name=\"category 5 percentage\">\n                                    5%\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-4-2-6\" data-name=\"category row 6\">\n                                <span data-kid=\"1-2-4-2-2-4-2-6-1\" data-name=\"category 6 name\">\n                                    쇼핑\n                                </span>\n                                <span data-kid=\"1-2-4-2-2-4-2-6-2\" data-name=\"category 6 value\">\n                                    300,000원\n                                </span>\n                                <span class=\"text-[var(--muted)]\" data-kid=\"1-2-4-2-2-4-2-6-3\" data-name=\"category 6 percentage\">\n                                    5%\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-11 border-t border-[var(--rule)] pt-5\" data-kid=\"1-2-4-2-2-5\" data-name=\"expense ledger section\">\n                        <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-2-4-2-2-5-1\" data-name=\"ledger header\">\n                            <span class=\"text-[9px] font-semibold tracking-[0.17em] text-[var(--muted)]\" data-kid=\"1-2-4-2-2-5-1-1\" data-name=\"ledger label\">\n                                EXPENSE LEDGER\n                            </span>\n                            <span class=\"text-[9px] font-semibold tracking-[0.12em] text-[var(--olive)]\" data-kid=\"1-2-4-2-2-5-1-2\" data-name=\"payer info\">\n                                PAYER / 영숙\n                            </span>\n                        </div>\n                        <div class=\"text-[10px]\" data-kid=\"1-2-4-2-2-5-2\" data-name=\"ledger items\">\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-5-2-1\" data-name=\"ledger row 1\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-2-2-5-2-1-1\" data-name=\"expense description 1\">\n                                    <div class=\"font-semibold leading-[1.45]\" data-kid=\"1-2-4-2-2-5-2-1-1-1\" data-name=\"expense title 1\">\n                                        4일간의 최고급 미식 비용 (식비 전체 예상)\n                                    </div>\n                                    <div class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"1-2-4-2-2-5-2-1-1-2\" data-name=\"expense meta 1\">\n                                        9. 20. (월) · 식비 · 영숙\n                                    </div>\n                                </div>\n                                <span class=\"whitespace-nowrap font-semibold\" data-kid=\"1-2-4-2-2-5-2-1-2\" data-name=\"expense amount 1\">\n                                    1,200,000원\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-5-2-2\" data-name=\"ledger row 2\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-2-2-5-2-2-1\" data-name=\"expense description 2\">\n                                    <div class=\"font-semibold leading-[1.45]\" data-kid=\"1-2-4-2-2-5-2-2-1-1\" data-name=\"expense title 2\">\n                                        공동 쇼핑 예산 (도자기 등 아기자기한 소품)\n                                    </div>\n                                    <div class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"1-2-4-2-2-5-2-2-1-2\" data-name=\"expense meta 2\">\n                                        9. 17. (금) · 쇼핑 · 영숙\n                                    </div>\n                                </div>\n                                <span class=\"whitespace-nowrap font-semibold\" data-kid=\"1-2-4-2-2-5-2-2-2\" data-name=\"expense amount 2\">\n                                    300,000원\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-5-2-3\" data-name=\"ledger row 3\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-2-2-5-2-3-1\" data-name=\"expense description 3\">\n                                    <div class=\"font-semibold leading-[1.45]\" data-kid=\"1-2-4-2-2-5-2-3-1-1\" data-name=\"expense title 3\">\n                                        차탄 프라이빗 요트 선셋 투어\n                                    </div>\n                                    <div class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"1-2-4-2-2-5-2-3-1-2\" data-name=\"expense meta 3\">\n                                        9. 19. (일) · 액티비티 · 영숙\n                                    </div>\n                                </div>\n                                <span class=\"whitespace-nowrap font-semibold\" data-kid=\"1-2-4-2-2-5-2-3-2\" data-name=\"expense amount 3\">\n                                    300,000원\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-5-2-4\" data-name=\"ledger row 4\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-2-2-5-2-4-1\" data-name=\"expense description 4\">\n                                    <div class=\"font-semibold leading-[1.45]\" data-kid=\"1-2-4-2-2-5-2-4-1-1\" data-name=\"expense title 4\">\n                                        알파드 렌터카 4일 (중/남부만 이동, 유류비 절감)\n                                    </div>\n                                    <div class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"1-2-4-2-2-5-2-4-1-2\" data-name=\"expense meta 4\">\n                                        8. 1. (일) · 교통 · 영숙\n                                    </div>\n                                </div>\n                                <span class=\"whitespace-nowrap font-semibold\" data-kid=\"1-2-4-2-2-5-2-4-2\" data-name=\"expense amount 4\">\n                                    400,000원\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-5-2-5\" data-name=\"ledger row 5\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-2-2-5-2-5-1\" data-name=\"expense description 5\">\n                                    <div class=\"font-semibold leading-[1.45]\" data-kid=\"1-2-4-2-2-5-2-5-1-1\" data-name=\"expense title 5\">\n                                        하얏트 1박 + 힐튼 2박 (럭셔리 오션뷰 객실 2개)\n                                    </div>\n                                    <div class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"1-2-4-2-2-5-2-5-1-2\" data-name=\"expense meta 5\">\n                                        7. 5. (월) · 숙박 · 영숙\n                                    </div>\n                                </div>\n                                <span class=\"whitespace-nowrap font-semibold\" data-kid=\"1-2-4-2-2-5-2-5-2\" data-name=\"expense amount 5\">\n                                    2,000,000원\n                                </span>\n                            </div>\n                            <div class=\"grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-b border-[var(--rule)] py-4\" data-kid=\"1-2-4-2-2-5-2-6\" data-name=\"ledger row 6\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-2-2-5-2-6-1\" data-name=\"expense description 6\">\n                                    <div class=\"font-semibold leading-[1.45]\" data-kid=\"1-2-4-2-2-5-2-6-1-1\" data-name=\"expense title 6\">\n                                        4인 왕복 항공권 (대한항공)\n                                    </div>\n                                    <div class=\"mt-1 text-[10px] text-[var(--muted)]\" data-kid=\"1-2-4-2-2-5-2-6-1-2\" data-name=\"expense meta 6\">\n                                        7. 1. (목) · 항공 · 영숙\n                                    </div>\n                                </div>\n                                <span class=\"whitespace-nowrap font-semibold\" data-kid=\"1-2-4-2-2-5-2-6-2\" data-name=\"expense amount 6\">\n                                    1,500,000원\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n        </section>\n        <footer class=\"flex items-center justify-between py-8 text-[10px] font-semibold tracking-[0.16em] text-[var(--muted)]\" data-kid=\"1-2-5\" data-name=\"footer section\">\n            <span data-kid=\"1-2-5-1\" data-name=\"footer concept info\">\n                PACK TO GO / CONCEPT 01 — editorial route\n            </span>\n            <span data-kid=\"1-2-5-2\" data-name=\"footer end note\">\n                END OF BOARD / 01—03\n            </span>\n        </footer>\n    </main>\n</div>\n",
