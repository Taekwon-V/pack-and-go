      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root {\n  --paper: #F9F8F6;\n  --ink: #1C1C1A;\n  --olive: #4A5D23;\n  --terra: #C05A3A;\n  --rule: #DAD6CD;\n  --muted: #716F68;\n  --sand: #ECE9E1;\n}\n\n.font-display { font-family: 'Playfair Display', Georgia, serif; }\n.font-ui { font-family: 'Montserrat', Arial, sans-serif; }\n.map-paper {\n  background-color: var(--sand);\n  background-image: linear-gradient(to right, #d8d3c8 1px, transparent 1px), linear-gradient(to bottom, #d8d3c8 1px, transparent 1px);\n  background-size: 48px 48px;\n  background-position: -1px -1px;\n}\n\n@media (max-width: 899px) {\n  .board-shell { padding-left: 20px !important; padding-right: 20px !important; }\n  .nav-links { gap: 14px !important; font-size: 8px !important; }\n  .concept-meta { align-items: flex-start !important; flex-direction: column !important; gap: 10px !important; }\n  .screen-01-grid, .screen-02-grid, .screen-03-grid { grid-template-columns: minmax(0, 1fr) !important; }\n  .screen-01-main, .screen-01-aside, .screen-02-main, .screen-02-aside, .screen-03-main, .screen-03-aside { grid-column: auto !important; }\n  .screen-01-aside { margin-top: 72px; }\n  .screen-02-aside { border-left: 0 !important; border-top: 1px solid var(--rule); margin-top: 56px; padding-left: 0 !important; padding-top: 28px; }\n  .hero-copy { width: 100% !important; }\n  .feature-image { height: 380px !important; }\n  .overview-image { height: 360px !important; }\n  .screen-heading { font-size: 50px !important; }\n  .screen-03-aside { border-left: 0 !important; border-top: 1px solid var(--rule); margin-top: 64px; padding-left: 0 !important; padding-top: 32px; }\n  .tabs-scroll { overflow-x: auto; }\n  .budget-stats { gap: 18px !important; }\n}\n\n@media (max-width: 560px) {\n  .nav-wordmark { font-size: 15px !important; }\n  .nav-links span:nth-child(2) { display: none; }\n  .screen-heading { font-size: 42px !important; }\n  .feature-image { height: 260px !important; }\n  .overview-image { height: 270px !important; }\n  .hero-copy { padding: 20px !important; }\n  .hero-copy h2 { font-size: 34px !important; }\n  .budget-stats { grid-template-columns: minmax(0, 1fr) !important; }\n  .timeline-entry { grid-template-columns: 1fr 18px !important; }\n  .timeline-time { grid-column: 1 / -1; margin-bottom: 3px; }\n  .timeline-copy { grid-column: 1 / 2; }\n  .timeline-chevron { grid-column: 2 / 3; grid-row: 2; }\n  .timeline-line { left: 8px !important; }\n  .timeline-node { left: 4px !important; }\n}\n</style>\n<div class=\"min-h-screen overflow-x-clip bg-[var(--paper)] text-[var(--ink)] font-ui antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"sticky top-0 z-40 border-b border-[var(--rule)] bg-[var(--paper)]\" data-kid=\"1-1\" data-name=\"header navigation section\">\n        <div class=\"board-shell mx-auto flex h-[72px] max-w-[1280px] items-center justify-between\" data-kid=\"1-1-1\" data-name=\"nav inner container\">\n            <div class=\"nav-wordmark text-[17px] font-semibold tracking-[-0.04em]\" data-kid=\"1-1-1-1\" data-name=\"brand name\">\n                Pack to Go\n            </div>\n            <nav class=\"nav-links flex items-center gap-10 text-[10px] font-semibold tracking-[0.2em]\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n                <span class=\"text-[var(--olive)]\" data-kid=\"1-1-1-2-1\" data-name=\"travel journal link\">\n                    TRAVEL JOURNAL\n                </span>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"my trips link\">\n                    MY TRIPS\n                </span>\n                <span data-kid=\"1-1-1-2-3\" data-name=\"log out link\">\n                    LOG OUT\n                </span>\n            </nav>\n        </div>\n    </header>\n    <main class=\"board-shell mx-auto max-w-[1280px]\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"concept-meta flex items-center justify-between border-b border-[var(--rule)] py-5 text-[10px] font-semibold tracking-[0.18em]\" data-kid=\"1-2-1\" data-name=\"concept metadata header\">\n            <span data-kid=\"1-2-1-1\" data-name=\"editorial title text\">\n                01 · Editorial Travel Magazine\n            </span>\n            <span class=\"text-[var(--olive)]\" data-kid=\"1-2-1-2\" data-name=\"board identification breadcrumb\">\n                PACK TO GO / CONCEPT BOARD / 1440\n            </span>\n        </div>\n        <section aria-labelledby=\"screen-one-title\" class=\"border-b border-[var(--rule)] py-20\" data-kid=\"1-2-2\" data-name=\"hero section\">\n            <div class=\"mb-12 flex items-end justify-between\" data-kid=\"1-2-2-1\" data-name=\"hero header container\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"hero title group\">\n                    <div class=\"mb-5 flex items-center gap-3 text-[10px] font-semibold tracking-[0.2em] text-[var(--olive)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"hero status indicator group\">\n                        <span class=\"h-[6px] w-[6px] bg-[var(--terra)]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"status dot\">\n                        </span>\n                        <span data-kid=\"1-2-2-1-1-1-2\" data-name=\"trip index label\">\n                            01 / TRIP INDEX\n                        </span>\n                    </div>\n                    <h1 class=\"screen-heading font-display text-[68px] leading-[0.96] tracking-[-0.06em]\" data-kid=\"1-2-2-1-1-2\" data-name=\"hero headline text\" id=\"screen-one-title\">\n                        다음 여행을,\n                        <br data-kid=\"1-2-2-1-1-2-1\" data-name=\"headline line break\"/>\n                        더 선명하게.\n                    </h1>\n                </div>\n                <div class=\"hidden pb-1 text-right text-[9px] font-semibold leading-[1.6] tracking-[0.17em] text-[var(--muted)] md:block\" data-kid=\"1-2-2-1-2\" data-name=\"hero context note\">\n                    ONE ACTIVE JOURNEY\n                    <br data-kid=\"1-2-2-1-2-1\" data-name=\"context line break\"/>\n                    A FIELD NOTE IN PROGRESS\n                </div>\n            </div>\n            <div class=\"screen-01-grid grid grid-cols-12 gap-x-12\" data-kid=\"1-2-2-2\" data-name=\"hero content grid\">\n                <div class=\"screen-01-main col-span-8 min-w-0\" data-kid=\"1-2-2-2-1\" data-name=\"main content column\">\n                    <figure class=\"relative pb-10\" data-kid=\"1-2-2-2-1-1\" data-name=\"featured image figure\">\n                        <div class=\"feature-image relative h-[450px] overflow-hidden bg-[var(--sand)]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"featured image container\">\n                            <img alt=\"Okinawa coastal town — Damian Ochrymowicz on Unsplash\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-2-2-2-1-1-1-1\" data-name=\"featured destination image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1760736114536-3b326d8c745e?auto=format&w=1400&q=80&fit=crop\"/>\n                        </div>\n                        <figcaption class=\"absolute bottom-0 left-8 right-8 flex items-end justify-between border-t-[3px] border-[var(--terra)] bg-[var(--paper)] px-6 pb-1 pt-5\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"featured image caption\">\n                            <h2 class=\"font-display text-[38px] leading-none tracking-[-0.045em]\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"featured image title\">\n                                40대의 마지막 오키나와\n                            </h2>\n                            <span class=\"shrink-0 pb-1 pl-5 text-[9px] font-semibold tracking-[0.17em] text-[var(--olive)]\" data-kid=\"1-2-2-2-1-1-2-2\" data-name=\"featured image tag\">\n                                ACTIVE JOURNEY / 01\n                            </span>\n                        </figcaption>\n                    </figure>\n                </div>\n                <aside aria-label=\"Current journey metadata\" class=\"screen-01-aside col-span-4 self-end border-t border-[var(--rule)] pt-6\" data-kid=\"1-2-2-2-2\" data-name=\"current journey metadata sidebar\">\n                    <div class=\"mb-10 flex items-center justify-between\" data-kid=\"1-2-2-2-2-1\" data-name=\"sidebar header\">\n                        <span class=\"text-[10px] font-semibold tracking-[0.18em] text-[var(--olive)]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"sidebar header title\">\n                            CURRENT JOURNEY\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-[18px] text-[var(--terra)]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"external link arrow icon\">\n                        </i>\n                    </div>\n                    <dl class=\"space-y-7\" data-kid=\"1-2-2-2-2-2\" data-name=\"trip detail list\">\n                        <div data-kid=\"1-2-2-2-2-2-1\" data-name=\"destination container\">\n                            <dt class=\"mb-2 flex items-center gap-2 text-[9px] font-semibold tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"destination label\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[14px] text-[var(--terra)]\" data-kid=\"1-2-2-2-2-2-1-1-1\" data-name=\"pin icon\">\n                                </i>\n                                DESTINATION\n                            </dt>\n                            <dd class=\"text-[15px] font-semibold tracking-[-0.02em]\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"destination name\">\n                                오키나와 (나하 & 차탄)\n                            </dd>\n                        </div>\n                        <div data-kid=\"1-2-2-2-2-2-2\" data-name=\"dates container\">\n                            <dt class=\"mb-2 flex items-center gap-2 text-[9px] font-semibold tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"dates label\">\n                                <i aria-hidden=\"true\" class=\"ti ti-calendar text-[14px] text-[var(--terra)]\" data-kid=\"1-2-2-2-2-2-2-1-1\" data-name=\"calendar icon\">\n                                </i>\n                                DATES\n                            </dt>\n                            <dd class=\"text-[15px] font-semibold tracking-[-0.02em]\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"date range text\">\n                                2027. 9. 17. — 2027. 9. 21.\n                            </dd>\n                        </div>\n                        <div class=\"flex items-end justify-between border-t border-[var(--rule)] pt-5\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"members detail container\">\n                            <div data-kid=\"1-2-2-2-2-2-3-1\" data-name=\"members label container\">\n                                <dt class=\"mb-2 flex items-center gap-2 text-[9px] font-semibold tracking-[0.18em] text-[var(--muted)]\" data-kid=\"1-2-2-2-2-2-3-1-1\" data-name=\"members label\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-users text-[14px] text-[var(--terra)]\" data-kid=\"1-2-2-2-2-2-3-1-1-1\" data-name=\"users icon\">\n                                    </i>\n                                    MEMBERS\n                                </dt>\n                                <dd class=\"text-[15px] font-semibold tracking-[-0.02em]\" data-kid=\"1-2-2-2-2-2-3-1-2\" data-name=\"member count\">\n                                    멤버 2명\n                                </dd>\n                            </div>\n                            <div class=\"font-display text-[52px] leading-none tracking-[-0.05em] text-[var(--terra)]\" data-kid=\"1-2-2-2-2-2-3-2\" data-name=\"countdown display text\">\n                                D-393\n                            </div>\n                        </div>\n                    </dl>\n                    <p class=\"mt-16 border-t border-[var(--rule)] pt-4 text-[10px] font-semibold tracking-[0.12em] text-[var(--muted)]\" data-kid=\"1-2-2-2-2-3\" data-name=\"active trips counter text\">\n                        현재 진행 중인 여행 1개\n                    </p>\n                </aside>\n            </div>\n        </section>\n        <section aria-labelledby=\"screen-two-title\" class=\"border-b border-[var(--rule)] py-24\" data-kid=\"1-2-3\" data-name=\"trip overview section\">\n            <div class=\"mb-8 flex items-center justify-between border-b border-[var(--rule)] pb-5 text-[10px] font-semibold tracking-[0.18em]\" data-kid=\"1-2-3-1\" data-name=\"overview header\">\n                <span class=\"text-[var(--olive)]\" data-kid=\"1-2-3-1-1\" data-name=\"overview title\">\n                    02 / TRIP OVERVIEW\n                </span>\n                <div class=\"flex items-center gap-5 text-right text-[9px]\" data-kid=\"1-2-3-1-2\" data-name=\"overview details container\">\n                    <span class=\"text-[var(--muted)]\" data-kid=\"1-2-3-1-2-1\" data-name=\"overview destination summary\">\n                        오키나와 (나하 & 차탄) · 멤버 2명\n                    </span>\n                    <span data-kid=\"1-2-3-1-2-2\" data-name=\"overview dates summary\">\n                        17—21 SEPTEMBER 2027\n                    </span>\n                </div>\n            </div>\n            <figure class=\"relative\" data-kid=\"1-2-3-2\" data-name=\"overview image figure\">\n                <div class=\"overview-image relative h-[440px] overflow-hidden bg-[var(--sand)]\" data-kid=\"1-2-3-2-1\" data-name=\"overview image container\">\n                    <img alt=\"Okinawa coastal town — Damian Ochrymowicz on Unsplash\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-2-3-2-1-1\" data-name=\"overview image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1760736114536-3b326d8c745e?auto=format&w=1400&q=80&fit=crop\"/>\n                </div>\n                <figcaption class=\"hero-copy absolute bottom-0 left-0 w-[68%] bg-[var(--paper)] px-8 pb-7 pt-6\" data-kid=\"1-2-3-2-2\" data-name=\"overview image caption box\">\n                    <div class=\"mb-3 text-[9px] font-semibold tracking-[0.2em] text-[var(--terra)]\" data-kid=\"1-2-3-2-2-1\" data-name=\"overview caption top label\">\n                        PACK TO GO / OKINAWA\n                    </div>\n                    <h2 class=\"font-display text-[54px] leading-[0.98] tracking-[-0.055em]\" data-kid=\"1-2-3-2-2-2\" data-name=\"overview headline\" id=\"screen-two-title\">\n                        40대의 마지막 오키나와\n                    </h2>\n                    <p class=\"mt-3 font-display text-[19px] italic leading-tight text-black/60\" data-kid=\"1-2-3-2-2-3\" data-name=\"overview subheadline quote\">\n                        “맛있는 일본 여행, 잔잔한 파도소리, 그리고 오키나와의 여유”\n                    </p>\n                </figcaption>\n            </figure>\n            <div class=\"screen-02-grid mt-16 grid grid-cols-12 gap-x-12\" data-kid=\"1-2-3-3\" data-name=\"overview content grid\">\n                <article class=\"screen-02-main col-span-7 min-w-0 border-t border-[var(--rule)] pt-5\" data-kid=\"1-2-3-3-1\" data-name=\"overview main column\">\n                    <div class=\"mb-8 flex items-center justify-between\" data-kid=\"1-2-3-3-1-1\" data-name=\"destination header\">\n                        <span class=\"text-[10px] font-semibold tracking-[0.18em] text-[var(--olive)]\" data-kid=\"1-2-3-3-1-1-1\" data-name=\"destination header title\">\n                            THE DESTINATION / 01\n                        </span>\n                        <span class=\"font-display text-[20px] tracking-[-0.03em]\" data-kid=\"1-2-3-3-1-1-2\" data-name=\"destination name\">\n                            Naha — Chatan\n                        </span>\n                    </div>\n                    <div class=\"space-y-0\" data-kid=\"1-2-3-3-1-2\" data-name=\"destination highlights list\">\n                        <div class=\"grid grid-cols-[42px_24px_minmax(0,1fr)] items-center gap-3 border-b border-[var(--rule)] py-5\" data-kid=\"1-2-3-3-1-2-1\" data-name=\"highlight item 1\">\n                            <span class=\"font-display text-[22px] text-[var(--terra)]\" data-kid=\"1-2-3-3-1-2-1-1\" data-name=\"highlight index 1\">\n                                01\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-compass text-[17px] text-[var(--olive)]\" data-kid=\"1-2-3-3-1-2-1-2\" data-name=\"compass icon 1\">\n                            </i>\n                            <p class=\"font-display text-[23px] leading-tight tracking-[-0.03em]\" data-kid=\"1-2-3-3-1-2-1-3\" data-name=\"highlight description 1\">\n                                에메랄드빛 아열대 낙원\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-[42px_24px_minmax(0,1fr)] items-center gap-3 border-b border-[var(--rule)] py-5\" data-kid=\"1-2-3-3-1-2-2\" data-name=\"highlight item 2\">\n                            <span class=\"font-display text-[22px] text-[var(--terra)]\" data-kid=\"1-2-3-3-1-2-2-1\" data-name=\"highlight index 2\">\n                                02\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[17px] text-[var(--olive)]\" data-kid=\"1-2-3-3-1-2-2-2\" data-name=\"pin icon 2\">\n                            </i>\n                            <p class=\"font-display text-[23px] leading-tight tracking-[-0.03em]\" data-kid=\"1-2-3-3-1-2-2-3\" data-name=\"highlight description 2\">\n                                독자적인 류큐 왕국의 숨결\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-[42px_24px_minmax(0,1fr)] items-center gap-3 border-b border-[var(--rule)] py-5\" data-kid=\"1-2-3-3-1-2-3\" data-name=\"highlight item 3\">\n                            <span class=\"font-display text-[22px] text-[var(--terra)]\" data-kid=\"1-2-3-3-1-2-3-1\" data-name=\"highlight index 3\">\n                                03\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-users text-[17px] text-[var(--olive)]\" data-kid=\"1-2-3-3-1-2-3-2\" data-name=\"users icon 3\">\n                            </i>\n                            <p class=\"font-display text-[23px] leading-tight tracking-[-0.03em]\" data-kid=\"1-2-3-3-1-2-3-3\" data-name=\"highlight description 3\">\n                                동서양이 만나는 문화 융합\n                            </p>\n                        </div>\n                        <div class=\"grid grid-cols-[42px_24px_minmax(0,1fr)] items-center gap-3 border-b border-[var(--rule)] py-5\" data-kid=\"1-2-3-3-1-2-4\" data-name=\"highlight item 4\">\n                            <span class=\"font-display text-[22px] text-[var(--terra)]\" data-kid=\"1-2-3-3-1-2-4-1\" data-name=\"highlight index 4\">\n                                04\n                            </span>\n                            <i aria-hidden=\"true\" class=\"ti ti-compass text-[17px] text-[var(--olive)]\" data-kid=\"1-2-3-3-1-2-4-2\" data-name=\"compass icon 4\">\n                            </i>\n                            <p class=\"font-display text-[23px] leading-tight tracking-[-0.03em]\" data-kid=\"1-2-3-3-1-2-4-3\" data-name=\"highlight description 4\">\n                                사계절 내내 완벽한 휴양\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-9 grid grid-cols-2 gap-8 border-t border-[var(--rule)] pt-5 text-[12px] leading-[1.85]\" data-kid=\"1-2-3-3-1-3\" data-name=\"destination details row\">\n                        <div data-kid=\"1-2-3-3-1-3-1\" data-name=\"weather detail column\">\n                            <div class=\"mb-2 text-[9px] font-semibold tracking-[0.18em] text-[var(--olive)]\" data-kid=\"1-2-3-3-1-3-1-1\" data-name=\"weather label\">\n                                WEATHER\n                            </div>\n                            <p data-kid=\"1-2-3-3-1-3-1-2\" data-name=\"weather description\">\n                                평균 기온 20도, 맑고 화창한 봄 날씨 (가끔 흐림)\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-3-3-1-3-2\" data-name=\"packing detail column\">\n                            <div class=\"mb-2 text-[9px] font-semibold tracking-[0.18em] text-[var(--olive)]\" data-kid=\"1-2-3-3-1-3-2-1\" data-name=\"packing note label\">\n                                PACKING NOTE\n                            </div>\n                            <p data-kid=\"1-2-3-3-1-3-2-2\" data-name=\"packing note description\">\n                                초가을의 선선한 바람이 부는 날씨. 반팔 위주의 가벼운 옷차림과 저녁을 위한 겉옷\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <aside aria-label=\"Okinawa map and gallery\" class=\"screen-02-aside col-start-8 col-span-5 min-w-0 border-t border-[var(--rule)] pt-5\" data-kid=\"1-2-3-3-2\" data-name=\"map sidebar\">\n                    <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-2-3-3-2-1\" data-name=\"sidebar header\">\n                        <span class=\"text-[10px] font-semibold tracking-[0.18em] text-[var(--olive)]\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"map label\">\n                            CHatan, Okinawa / MAP\n                        </span>\n                        <i aria-hidden=\"true\" class=\"ti ti-map-pin text-[18px] text-[var(--terra)]\" data-kid=\"1-2-3-3-2-1-2\" data-name=\"pin icon\">\n                        </i>\n                    </div>\n                    <div class=\"map-paper relative h-[310px] overflow-hidden border border-[var(--rule)]\" data-kid=\"1-2-3-3-2-2\" data-name=\"interactive map container\">\n                        <svg aria-hidden=\"true\" class=\"absolute inset-0 h-full w-full\" data-kid=\"1-2-3-3-2-2-1\" data-name=\"svg map graphic\" viewbox=\"0 0 520 310\">\n                            <path d=\"M-20 89 C72 53 119 139 205 109 S343 28 549 88\" fill=\"none\" stroke=\"var(--rule)\" stroke-width=\"1\">\n                            </path>\n                            <path d=\"M-18 238 C84 177 138 258 240 201 S405 181 545 226\" fill=\"none\" stroke=\"var(--rule)\" stroke-width=\"1\">\n                            </path>\n                            <path d=\"M62 266 C132 228 157 91 275 119 S361 226 473 51\" fill=\"none\" stroke=\"var(--olive)\" stroke-dasharray=\"5 7\" stroke-width=\"1.5\">\n                            </path>\n                            <circle cx=\"275\" cy=\"119\" fill=\"var(--terra)\" r=\"5\">\n                            </circle>\n                            <circle cx=\"275\" cy=\"119\" fill=\"none\" r=\"12\" stroke=\"var(--terra)\" stroke-width=\"1\">\n                            </circle>\n                        </svg>\n                        <div class=\"absolute left-5 top-5 text-[9px] font-semibold tracking-[0.15em] text-black/45\" data-kid=\"1-2-3-3-2-2-2\" data-name=\"map coordinates\">\n                            26° 20′ N / 127° 48′ E\n                        </div>\n                        <div class=\"absolute bottom-5 left-5 flex items-center gap-3 text-[11px] font-semibold\" data-kid=\"1-2-3-3-2-2-3\" data-name=\"user indicator\">\n                            <span class=\"h-[7px] w-[7px] bg-[var(--terra)]\" data-kid=\"1-2-3-3-2-2-3-1\" data-name=\"indicator dot\">\n                            </span>\n                            영숙 · Dev User\n                        </div>\n          