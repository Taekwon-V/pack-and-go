        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .ptg-board {\n    --midnight: #0B132B;\n    --midnight-deep: #070D20;\n    --ice: #A9D6E5;\n    --teal: #48CAE4;\n    --gold: #FFB703;\n    --surface: rgba(255,255,255,.065);\n    --surface-strong: rgba(255,255,255,.09);\n    --surface-soft: rgba(255,255,255,.04);\n    --line: rgba(255,255,255,.14);\n    --line-soft: rgba(255,255,255,.09);\n    position: relative;\n    min-height: 100%;\n    overflow-x: clip;\n    background: var(--midnight);\n    color: #fff;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    isolation: isolate;\n  }\n\n  .ptg-board h1,\n  .ptg-board h2,\n  .ptg-board h3,\n  .ptg-board h4,\n  .ptg-board p {\n    margin-top: 0;\n  }\n\n  .ptg-board h1,\n  .ptg-board h2,\n  .ptg-board h3,\n  .ptg-board h4,\n  .ptg-display {\n    font-family: 'Outfit', sans-serif;\n  }\n\n  .ptg-mesh {\n    position: fixed;\n    z-index: -1;\n    inset: -18%;\n    pointer-events: none;\n    opacity: .8;\n    background:\n      radial-gradient(ellipse at 16% 4%, rgba(72,202,228,.15) 0, rgba(72,202,228,.065) 17%, transparent 39%),\n      radial-gradient(ellipse at 88% 23%, rgba(255,183,3,.08) 0, rgba(255,183,3,.025) 15%, transparent 34%),\n      radial-gradient(ellipse at 60% 93%, rgba(36,121,155,.11) 0, transparent 34%);\n    filter: blur(2px);\n    animation: ptg-mesh-drift 18s ease-in-out infinite alternate;\n  }\n\n  @keyframes ptg-mesh-drift {\n    0% { transform: translate3d(-1%, -1%, 0) scale(1); }\n    100% { transform: translate3d(2%, 1%, 0) scale(1.045); }\n  }\n\n  .ptg-glass {\n    background: linear-gradient(135deg, rgba(255,255,255,.095), rgba(255,255,255,.045) 54%, rgba(169,214,229,.035));\n    border: 1px solid var(--line);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), inset 0 -1px 0 rgba(255,255,255,.035), 0 28px 72px rgba(0,0,0,.28);\n    backdrop-filter: blur(24px);\n    -webkit-backdrop-filter: blur(24px);\n  }\n\n  .ptg-glass-soft {\n    background: rgba(255,255,255,.042);\n    border: 1px solid var(--line-soft);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 18px 42px rgba(0,0,0,.18);\n    backdrop-filter: blur(18px);\n    -webkit-backdrop-filter: blur(18px);\n  }\n\n  .ptg-container {\n    width: min(1240px, calc(100% - 96px));\n    margin-inline: auto;\n  }\n\n  .ptg-nav {\n    min-height: 74px;\n    padding: 10px 12px 10px 20px;\n    border-radius: 999px;\n  }\n\n  .ptg-brand-mark {\n    display: grid;\n    width: 42px;\n    height: 42px;\n    flex: 0 0 42px;\n    place-items: center;\n    border: 1px solid rgba(72,202,228,.34);\n    border-radius: 14px;\n    background: rgba(72,202,228,.12);\n    color: var(--teal);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 8px 24px rgba(72,202,228,.08);\n  }\n\n  .ptg-nav-links {\n    scrollbar-width: none;\n  }\n\n  .ptg-nav-links::-webkit-scrollbar,\n  .ptg-day-tabs::-webkit-scrollbar {\n    display: none;\n  }\n\n  .ptg-nav-link {\n    display: inline-flex;\n    align-items: center;\n    min-height: 36px;\n    padding: 0 13px;\n    border-radius: 999px;\n    color: rgba(255,255,255,.58);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .17em;\n    white-space: nowrap;\n  }\n\n  .ptg-nav-link-active {\n    background: rgba(72,202,228,.12);\n    color: var(--teal);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.07);\n  }\n\n  .ptg-intro {\n    min-height: 300px;\n    padding: 76px 0 62px;\n    border-bottom: 1px solid var(--line-soft);\n  }\n\n  .ptg-kicker {\n    color: var(--teal);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .25em;\n    line-height: 1.4;\n    text-transform: uppercase;\n  }\n\n  .ptg-intro h1 {\n    max-width: 820px;\n    margin-bottom: 0;\n    color: #fff;\n    font-size: clamp(54px, 7vw, 92px);\n    font-weight: 600;\n    letter-spacing: -.045em;\n    line-height: .91;\n  }\n\n  .ptg-intro h1 em {\n    color: var(--ice);\n    font-style: normal;\n  }\n\n  .ptg-intro-note {\n    max-width: 260px;\n    color: rgba(255,255,255,.57);\n    font-size: 12px;\n    line-height: 1.75;\n    text-align: right;\n  }\n\n  .ptg-board-meta {\n    padding: 15px 0 0;\n    color: rgba(255,255,255,.4);\n    font-size: 9px;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .ptg-section {\n    position: relative;\n    padding: 74px 0 80px;\n  }\n\n  .ptg-section + .ptg-section {\n    border-top: 1px solid var(--line-soft);\n  }\n\n  .ptg-section-head {\n    display: flex;\n    align-items: end;\n    justify-content: space-between;\n    gap: 28px;\n    margin-bottom: 26px;\n  }\n\n  .ptg-section-head h2 {\n    margin-bottom: 0;\n    color: #fff;\n    font-size: clamp(29px, 3vw, 40px);\n    font-weight: 600;\n    letter-spacing: -.055em;\n    line-height: 1;\n  }\n\n  .ptg-section-note {\n    max-width: 250px;\n    color: rgba(255,255,255,.46);\n    font-size: 11px;\n    line-height: 1.65;\n    text-align: right;\n  }\n\n  .ptg-screen-code {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 12px;\n    color: var(--teal);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .22em;\n    text-transform: uppercase;\n  }\n\n  .ptg-screen-code::before {\n    width: 20px;\n    height: 1px;\n    background: var(--teal);\n    content: '';\n  }\n\n  .ptg-screen01-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1.58fr) minmax(280px, .72fr);\n    gap: 20px;\n    align-items: stretch;\n  }\n\n  .ptg-feature {\n    overflow: hidden;\n    border-radius: 24px;\n  }\n\n  .ptg-feature-media {\n    position: relative;\n    height: 514px;\n    min-height: 0;\n    overflow: hidden;\n    border-radius: 18px;\n    background: #121d3a;\n  }\n\n  .ptg-feature-media::after {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(11,19,43,.04) 30%, rgba(7,13,32,.04) 44%, rgba(7,13,32,.9) 100%);\n    content: '';\n    pointer-events: none;\n  }\n\n  .ptg-feature-media img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center 54%;\n    transform: scale(1.025);\n  }\n\n  .ptg-float-chip {\n    position: absolute;\n    z-index: 2;\n    top: 20px;\n    display: inline-flex;\n    align-items: center;\n    min-height: 32px;\n    padding: 0 12px;\n    border: 1px solid rgba(255,255,255,.18);\n    border-radius: 999px;\n    background: rgba(8,16,37,.58);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 10px 22px rgba(0,0,0,.15);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    font-size: 9px;\n    font-weight: 600;\n    letter-spacing: .14em;\n    white-space: nowrap;\n  }\n\n  .ptg-float-chip-left { left: 20px; color: var(--teal); }\n  .ptg-float-chip-right { right: 20px; color: #fff; letter-spacing: .08em; }\n\n  .ptg-feature-copy {\n    position: absolute;\n    z-index: 2;\n    right: 28px;\n    bottom: 27px;\n    left: 28px;\n  }\n\n  .ptg-feature-eyebrow {\n    margin-bottom: 10px;\n    color: var(--ice);\n    font-size: 9px;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n\n  .ptg-feature-copy h3 {\n    margin-bottom: 17px;\n    color: #fff;\n    font-size: clamp(31px, 3.5vw, 48px);\n    font-weight: 500;\n    letter-spacing: -.055em;\n    line-height: .98;\n  }\n\n  .ptg-meta-row {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 8px 17px;\n    color: var(--ice);\n    font-size: 11px;\n    line-height: 1.5;\n  }\n\n  .ptg-meta-row span {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    white-space: nowrap;\n  }\n\n  .ptg-meta-row i,\n  .ptg-icon-ice { color: var(--ice); }\n\n  .ptg-pulse {\n    display: flex;\n    min-height: 514px;\n    flex-direction: column;\n    justify-content: space-between;\n    border-radius: 24px;\n    padding: 28px;\n  }\n\n  .ptg-pulse-label {\n    color: var(--ice);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n\n  .ptg-pulse-number {\n    margin-top: 58px;\n    color: #fff;\n    font-size: clamp(68px, 7vw, 100px);\n    letter-spacing: -.09em;\n    line-height: .78;\n  }\n\n  .ptg-pulse-number small {\n    margin-left: 11px;\n    color: var(--ice);\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 13px;\n    font-weight: 500;\n    letter-spacing: 0;\n  }\n\n  .ptg-pulse-copy {\n    max-width: 190px;\n    margin-top: 20px;\n    color: rgba(255,255,255,.55);\n    font-size: 12px;\n    line-height: 1.75;\n  }\n\n  .ptg-pulse-footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding-top: 17px;\n    border-top: 1px solid var(--line-soft);\n    color: rgba(255,255,255,.5);\n    font-size: 10px;\n  }\n\n  .ptg-teal-text { color: var(--teal); }\n\n  .ptg-overview {\n    overflow: clip;\n  }\n\n  .ptg-overview-backdrop {\n    position: absolute;\n    z-index: -1;\n    inset: 24px 0 28px;\n    overflow: hidden;\n    background-image: linear-gradient(180deg, rgba(11,19,43,.71), rgba(11,19,43,.94)), url('https://images.unsplash.com/photo-1742317798833-93ea911ce2ce?auto=format&w=1400&q=80&fit=crop');\n    background-position: center;\n    background-size: cover;\n    filter: blur(20px);\n    opacity: .62;\n    transform: scale(1.055);\n  }\n\n  .ptg-overview-hero {\n    position: relative;\n    overflow: hidden;\n    border-radius: 24px;\n    padding: 35px 38px 32px;\n  }\n\n  .ptg-overview-hero::after {\n    position: absolute;\n    right: -75px;\n    bottom: -95px;\n    width: 320px;\n    height: 220px;\n    border-radius: 50%;\n    background: rgba(72,202,228,.055);\n    filter: blur(22px);\n    content: '';\n    pointer-events: none;\n  }\n\n  .ptg-overview-title {\n    position: relative;\n    z-index: 1;\n  }\n\n  .ptg-overview-title h2 {\n    margin-bottom: 10px;\n    color: #fff;\n    font-size: clamp(38px, 4.4vw, 62px);\n    font-weight: 500;\n    letter-spacing: -.068em;\n    line-height: .96;\n  }\n\n  .ptg-overview-concept {\n    max-width: 500px;\n    color: var(--ice);\n    font-size: 12px;\n    line-height: 1.7;\n  }\n\n  .ptg-fact-chips {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n    gap: 8px;\n  }\n\n  .ptg-fact-chip {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    min-height: 34px;\n    padding: 0 12px;\n    border: 1px solid var(--line);\n    border-radius: 999px;\n    color: var(--ice);\n    font-size: 10px;\n    white-space: nowrap;\n  }\n\n  .ptg-overview-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr);\n    gap: 20px;\n    margin-top: 20px;\n  }\n\n  .ptg-highlights {\n    border-radius: 0;\n    padding: 10px 0 0;\n  }\n\n  .ptg-panel-label {\n    margin-bottom: 20px;\n    color: var(--ice);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .19em;\n    text-transform: uppercase;\n  }\n\n  .ptg-highlight-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .ptg-highlight {\n    min-height: 157px;\n    padding: 18px 18px 18px 0;\n    border-top: 1px solid var(--line-soft);\n  }\n\n  .ptg-highlight:nth-child(even) {\n    padding-right: 0;\n    padding-left: 20px;\n    border-left: 1px solid var(--line-soft);\n  }\n\n  .ptg-highlight:nth-child(n+3) {\n    padding-top: 21px;\n  }\n\n  .ptg-highlight-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: flex-start;\n    width: auto;\n    height: 23px;\n    margin-bottom: 9px;\n    border: 0;\n    border-radius: 0;\n    font-size: 17px;\n  }\n\n  .ptg-highlight h4 {\n    margin-bottom: 7px;\n    color: #fff;\n    font-size: 16px;\n    font-weight: 500;\n    letter-spacing: -.025em;\n    line-height: 1.2;\n  }\n\n  .ptg-highlight p {\n    margin-bottom: 0;\n    color: rgba(255,255,255,.53);\n    font-size: 10px;\n    line-height: 1.65;\n  }\n\n  .ptg-cyan { color: var(--teal); }\n  .ptg-ice { color: var(--ice); }\n  .ptg-warm { color: var(--gold); }\n  .ptg-coral { color: #ff9aa9; }\n  .ptg-mint { color: #6dd4bd; }\n\n  .ptg-weather-row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 10px;\n    margin-top: 13px;\n    padding-top: 13px;\n    border-top: 1px solid var(--line-soft);\n  }\n\n  .ptg-weather-item {\n    padding: 13px 14px;\n    border: 1px solid var(--line-soft);\n    border-radius: 14px;\n    color: var(--ice);\n    font-size: 10px;\n    line-height: 1.55;\n  }\n\n  .ptg-weather-item strong {\n    display: block;\n    margin-top: 3px;\n    color: #fff;\n    font-family: 'Outfit', sans-serif;\n    font-size: 13px;\n    font-weight: 500;\n    letter-spacing: -.02em;\n  }\n\n  .ptg-overview-side {\n    display: grid;\n    grid-template-rows: minmax(270px, 1fr) auto;\n    gap: 20px;\n  }\n\n  .ptg-map-panel {\n    position: relative;\n    overflow: hidden;\n    min-height: 330px;\n    border-radius: 24px;\n  }\n\n  .ptg-map-canvas {\n    position: absolute;\n    inset: 0;\n    overflow: hidden;\n    background:\n      linear-gradient(rgba(72,202,228,.06) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(72,202,228,.06) 1px, transparent 1px),\n      radial-gradient(circle at 65% 42%, rgba(72,202,228,.2), transparent 26%),\n      linear-gradient(145deg, #122540, #0c1831 60%, #0a1429);\n    background-size: 36px 36px, 36px 36px, auto, auto;\n  }\n\n  .ptg-map-canvas::before {\n    position: absolute;\n    top: 20%;\n    left: 37%;\n    width: 47%;\n    height: 46%;\n    border: 1px solid rgba(169,214,229,.12);\n    border-radius: 58% 42% 49% 51% / 42% 55% 45% 58%;\n    background: rgba(169,214,229,.075);\n    box-shadow: inset 18px -10px 0 rgba(72,202,228,.025);\n    content: '';\n    transform: rotate(-22deg);\n  }\n\n  .ptg-map-canvas::after {\n    position: absolute;\n    top: 41%;\n    left: 46%;\n    width: 47%;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(72,202,228,.58), transparent);\n    content: '';\n    transform: rotate(-24deg);\n  }\n\n  .ptg-map-route {\n    position: absolute;\n    top: 30%;\n    left: 42%;\n    width: 35%;\n    height: 26%;\n    border: 1px dashed rgba(72,202,228,.38);\n    border-radius: 50%;\n    transform: rotate(-21deg);\n  }\n\n  .ptg-map-dot {\n    position: absolute;\n    z-index: 1;\n    width: 8px;\n    height: 8px;\n    border: 2px solid var(--teal);\n    border-radius: 50%;\n    background: var(--midnight);\n    box-shadow: 0 0 0 5px rgba(72,202,228,.1);\n  }\n\n  .ptg-map-dot-one { top: 40%; left: 57%; border-color: var(--gold); box-shadow: 0 0 0 5px rgba(255,183,3,.1); }\n  .ptg-map-dot-two { top: 52%; left: 69%; }\n\n  .ptg-map-copy {\n    position: absolute;\n    z-index: 2;\n    right: 22px;\n    bottom: 20px;\n    left: 22px;\n  }\n\n  .ptg-map-copy small {\n    color: var(--teal);\n    font-size: 9px;\n    letter-spacing: .2em;\n    text-transform: uppercase;\n  }\n\n  .ptg-map-copy h3 {\n    margin-bottom: 0;\n    color: #fff;\n    font-size: 22px;\n    font-weight: 500;\n    letter-spacing: -.04em;\n  }\n\n  .ptg-map-pin {\n    position: absolute;\n    z-index: 2;\n    top: 20px;\n    right: 20px;\n    color: var(--teal);\n    font-size: 21px;\n  }\n\n  .ptg-member {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    min-height: 85px;\n    border-radius: 20px;\n    padding: 16px 20px;\n  }\n\n  .ptg-avatar {\n    display: grid;\n    width: 38px;\n    height: 38px;\n    flex: 0 0 38px;\n    place-items: center;\n    border: 1px solid rgba(72,202,228,.55);\n    border-radius: 50%;\n    background: var(--teal);\n    color: var(--midnight);\n    font-family: 'Outfit', sans-serif;\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  .ptg-member-label {\n    margin-bottom: 4px;\n    color: rgba(255,255,255,.43);\n    font-size: 9px;\n    letter-spacing: .17em;\n    text-transform: uppercase;\n  }\n\n  .ptg-member-name {\n    color: #fff;\n    font-family: 'Outfit', sans-serif;\n    font-size: 16px;\n    letter-spacing: -.025em;\n  }\n\n  .ptg-gallery {\n    display: grid;\n    grid-template-columns: 1.55fr .72fr .72fr;\n    gap: 10px;\n    margin-top: 20px;\n  }\n\n  .ptg-gallery-figure {\n    position: relative;\n    height: 154px;\n    overflow: hidden;\n    margin: 0;\n    border: 1px solid var(--line-soft);\n    border-radius: 16px;\n    background-color: #111e36;\n    background-position: center;\n    background-size: cover;\n  }\n\n  .ptg-gallery-one {\n    background-image: linear-gradient(rgba(11,19,43,.16), rgba(11,19,43,.42)), url('/api/local/images/public/gallery/1.jpg'), url('https://images.unsplash.com/photo-1742317798833-93ea911ce2ce?auto=format&w=900&q=80&fit=crop');\n  }\n\n  .ptg-gallery-two {\n    background-image: linear-gradient(rgba(11,19,43,.16), rgba(11,19,43,.42)), url('/api/local/images/public/gallery/2.png'), url('https://images.unsplash.com/photo-1742317798833-93ea911ce2ce?auto=format&w=700&q=80&fit=crop');\n  }\n\n  .ptg-gallery-three {\n    background-image: linear-gradient(rgba(11,19,43,.16), rgba(11,19,43,.42)), url('/api/local/images/public/gallery/3.jpg'), url('https://images.unsplash.com/photo-1742317798833-93ea911ce2ce?auto=format&w=700&q=80&fit=crop');\n  }\n\n  .ptg-gallery-figure::after {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, transparent 30%, rgba(7,13,32,.6));\n    content: '';\n    pointer-events: none;\n  }\n\n  .ptg-gallery-figure img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    filter: saturate(.72) contrast(.98);\n    opacity: .78;\n  }\n\n  .ptg-gallery-figure figcaption {\n    position: absolute;\n    z-index: 1;\n    right: 12px;\n    bottom: 10px;\n    left: 12px;\n    color: rgba(255,255,255,.78);\n    font-size: 9px;\n    letter-spacing: .11em;\n    text-transform: uppercase;\n  }\n\n  .ptg-itinerary-head {\n    align-items: end;\n  }\n\n  .ptg-day-tabs {\n    display: flex;\n    width: max-content;\n    max-width: 100%;\n    gap: 5px;\n    margin-bottom: 20px;\n    overflow-x: auto;\n    scrollbar-width: none;\n    border-radius: 18px;\n    padding: 7px;\n  }\n\n  .ptg-day-tab {\n    display: flex;\n    min-width: 124px;\n    min-height: 59px;\n    flex-direction: column;\n    justify-content: center;\n    gap: 4px;\n    border-radius: 12px;\n    padding: 0 17px;\n    color: rgba(255,255,255,.48);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .12em;\n    line-height: 1.05;\n    white-space: nowrap;\n  }\n\n  .ptg-day-tab small {\n    color: inherit;\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 9px;\n    font-weight: 500;\n    letter-spacing: .04em;\n    opacity: .78;\n  }\n\n  .ptg-day-tab-active {\n    background: var(--teal);\n    color: var(--midnight);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 10px 25px rgba(72,202,228,.13);\n  }\n\n  .ptg-screen03-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1.1fr) minmax(390px, .9fr);\n    gap: 20px;\n    align-items: stretch;\n  }\n\n  .ptg-timeline-panel,\n  .ptg-budget-panel {\n    border-radius: 24px;\n    padding: 28px;\n  }\n\n  .ptg-timeline-panel {\n    min-height: 650px;\n    padding: 28px 0 28px 4px;\n  }\n\n  .ptg-timeline-heading {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 15px;\n    padding-bottom: 17px;\n    border-bottom: 1px solid var(--line-soft);\n  }\n\n  .ptg-timeline-heading span {\n    color: var(--ice);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .17em;\n    text-transform: uppercase;\n  }\n\n  .ptg-timeline {\n    position: relative;\n    padding: 9px 0 0 39px;\n  }\n\n  .ptg-timeline::before {\n    position: absolute;\n    top: 31px;\n    bottom: 36px;\n    left: 9px;\n    width: 1px;\n    background: linear-gradient(180deg, var(--teal), rgba(72,202,228,.12));\n    content: '';\n  }\n\n  .ptg-timeline-row {\n    position: relative;\n    margin-top: 15px;\n    border: 1px solid var(--line-soft);\n    border-radius: 16px;\n    background: rgba(255,255,255,.045);\n    padding: 18px 20px 17px;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.055);\n  }\n\n  .ptg-timeline-row:first-child { margin-top: 15px; }\n\n  .ptg-timeline-row::before {\n    position: absolute;\n    top: 28px;\n    left: -34px;\n    width: 9px;\n    height: 9px;\n    border: 2px solid var(--teal);\n    border-radius: 50%;\n    background: var(--midnight);\n    box-shadow: 0 0 0 5px rgba(72,202,228,.08);\n    content: '';\n  }\n\n  .ptg-time {\n    margin-bottom: 7px;\n    color: var(--teal);\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .03em;\n  }\n\n  .ptg-timeline-row h3 {\n    margin-bottom: 7px;\n    color: #fff;\n    font-size: 19px;\n    font-weight: 500;\n    letter-spacing: -.035em;\n    line-height: 1.1;\n  }\n\n  .ptg-location {\n    color: rgba(255,255,255,.46);\n    font-size: 10px;\n  }\n\n  .ptg-budget-panel {\n    min-height: 650px;\n  }\n\n  .ptg-budget-top {\n    display: flex;\n    align-items: start;\n    justify-content: space-between;\n    gap: 15px;\n  }\n\n  .ptg-budget-label {\n    color: var(--ice);\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: .19em;\n    text-transform: uppercase;\n  }\n\n  .ptg-budget-total {\n    margin-top: 14px;\n    color: #fff;\n    font-family: 'Outfit', sans-serif;\n    font-size: 30px;\n    letter-spacing: -.045em;\n  }\n\n  .ptg-budget-total span {\n    color: var(--ice);\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 14px;\n    letter-spacing: 0;\n  }\n\n  .ptg-budget-icon {\n    color: var(--teal);\n    font-size: 21px;\n  }\n\n  .ptg-budget-ring-wrap {\n    display: flex;\n    justify-content: center;\n    margin: 27px 0 26px;\n  }\n\n  .ptg-budget-ring {\n    display: grid;\n    width: 170px;\n    height: 170px;\n    place-items: center;\n    border-radius: 50%;\n    background: conic-gradient(var(--teal) 0deg 342deg, var(--gold) 342deg 360deg);\n    padding: 12px;\n    box-shadow: 0 12px 34px rgba(72,202,228,.1);\n  }\n\n  .ptg-budget-ring-inner {\n    display: grid;\n    width: 100%;\n    height: 100%;\n    place-items: center;\n    border-radius: 50%;\n    background: var(--midnight);\n    box-shadow: inset 0 1px 0 rgba(255,255,255,.07);\n    text-align: center;\n  }\n\n  .ptg-budget-ring-number {\n    color: #fff;\n    font-family: 'Outfit', sans-serif;\n    font-size: 32px;\n    letter-spacing: -.06em;\n    line-height: .95;\n  }\n\n  .ptg-budget-ring-number span {\n    color: var(--teal);\n    font-family: 'Plus Jakarta Sans', sans-serif;\n    font-size: 13px;\n    letter-spacing: 0;\n  }\n\n  .ptg-budget-ring-caption {\n    margin-top: 6px;\n    color: rgba(255,255,255,.45);\n    font-size: 9px;\n    letter-spacing: .14em;\n  }\n\n  .ptg-budget-stats {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px;\n    padding: 0 0 15px;\n    border-bottom: 1px solid var(--line-soft);\n  }\n\n  .ptg-budget-stat small {\n    display: block;\n    margin-bottom: 5px;\n    color: rgba(255,255,255,.45);\n    font-size: 10px;\n  }\n\n  .ptg-budget-stat strong {\n    color: #fff;\n    font-family: 'Outfit', sans-serif;\n    font-size: 17px;\n    font-weight: 500;\n    letter-spacing: -.025em;\n  }\n\n  .ptg-budget-stat:last-child {\n    text-align: right;\n  }\n\n  .ptg-budget-stat:last-child small,\n  .ptg-budget-stat:last-child strong {\n    color: var(--gold);\n  }\n\n  .ptg-expenses {\n    margin-top: 7px;\n  }\n\n  .ptg-expense-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    min-height: 42px;\n    border-bottom: 1px solid rgba(255,255,255,.065);\n    color: rgba(255,255,255,.72);\n    font-size: 11px;\n  }\n\n  .ptg-expense-row:last-child { border-bottom: 0; }\n\n  .ptg-expense-name {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    min-width: 0;\n  }\n\n  .ptg-expense-name i { color: var(--teal); }\n\n  .ptg-expense-payer {\n    color: rgba(255,255,255,.38);\n    font-size: 9px;\n  }\n\n  .ptg-expense-amount {\n    flex: 0 0 auto;\n    color: #fff;\n    font-family: 'Outfit', sans-serif;\n    font-size: 12px;\n    letter-spacing: -.015em;\n  }\n\n  .ptg-footer {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 22px 0 37px;\n    color: rgba(255,255,255,.42);\n    font-size: 9px;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  .ptg-footer strong {\n    color: var(--ice);\n    font-weight: 600;\n  }\n\n  @media (max-width: 900px) {\n    .ptg-container { width: min(100% - 40px, 680px); }\n    .ptg-nav { flex-wrap: wrap; overflow: hidden; border-radius: 24px; padding: 10px 12px; }\n    .ptg-nav-links { width: 100%; overflow-x: auto; padding: 4px 0 1px; }\n    .ptg-intro { min-height: 0; padding: 58px 0 46px; }\n    .ptg-intro-note { max-width: 390px; margin-top: 26px; text-align: left; }\n    .ptg-board-meta { padding-top: 14px; }\n    .ptg-section { padding: 70px 0 76px; }\n    .ptg-section-head { align-items: start; flex-direction: column; gap: 12px; }\n    .ptg-section-note { max-width: 360px; text-align: left; }\n    .ptg-screen01-grid,\n    .ptg-overview-grid,\n    .ptg-screen03-grid { grid-template-columns: 1fr; }\n    .ptg-feature-media { height: 460px; min-height: 0; }\n    .ptg-pulse { min-height: 330px; }\n    .ptg-pulse-number { margin-top: 42px; }\n    .ptg-overview-backdrop { inset: 18px 0 20px; filter: blur(14px); opacity: .52; }\n    .ptg-overview-hero::after { display: none; }\n    .ptg-overview-hero { padding: 28px 24px 25px; }\n    .ptg-overview-hero > div { flex-direction: column; align-items: start; }\n    .ptg-fact-chips { justify-content: flex-start; }\n    .ptg-highlights { padding: 10px 0 0; }\n    .ptg-overview-side { grid-template-rows: 300px auto; }\n    .ptg-gallery { grid-template-columns: 1.2fr .8fr; }\n    .ptg-gallery-figure:first-child { grid-column: span 2; }\n    .ptg-screen03-grid { gap: 16px; }\n    .ptg-timeline-panel, .ptg-budget-panel { min-height: 0; padding: 22px; }\n    .ptg-timeline-panel { min-height: 610px; }\n    .ptg-budget-panel { min-height: 620px; }\n  }\n\n  @media (max-width: 560px) {\n    .ptg-container { width: calc(100% - 28px); }\n    .ptg-brand-copy { min-width: 0; }\n    .ptg-brand-copy div:first-child { font-size: 18px !important; }\n    .ptg-brand-copy div:last-child { font-size: 8px !important; letter-spacing: .14em !important; }\n    .ptg-intro h1 { font-size: clamp(45px, 14vw, 70px); }\n    .ptg-intro-note { font-size: 11px; }\n    .ptg-feature-media { height: 475px; min-height: 0; }\n    .ptg-feature-copy { right: 19px; bottom: 21px; left: 19px; }\n    .ptg-feature-copy h3 { font-size: 31px; }\n    .ptg-meta-row { align-items: flex-start; flex-direction: column; gap: 5px; }\n    .ptg-pulse { min-height: 300px; padding: 22px; }\n    .ptg-highlight-grid { grid-template-columns: 1fr; }\n    .ptg-highlight,\n    .ptg-highlight:nth-child(even),\n    .ptg-highlight:nth-child(n+3) { min-height: 0; padding: 17px 0; border-left: 0; }\n    .ptg-weather-row { grid-template-columns: 1fr; }\n    .ptg-overview-side { grid-template-rows: 280px auto; }\n    .ptg-gallery { grid-template-columns: 1fr; }\n    .ptg-gallery-figure:first-child { grid-column: auto; }\n    .ptg-gallery-figure { height: 170px; }\n    .ptg-day-tab { min-width: 112px; padding: 0 14px; }\n    .ptg-timeline { padding-left: 29px; }\n    .ptg-timeline-row { padding: 16px 15px; }\n    .ptg-timeline-row::before { left: -24px; }\n    .ptg-timeline-row h3 { font-size: 16px; }\n    .ptg-budget-ring { width: 150px; height: 150px; }\n    .ptg-expense-row { gap: 8px; font-size: 10px; }\n    .ptg-expense-payer { display: block; }\n    .ptg-footer { align-items: flex-start; flex-direction: column; gap: 9px; }\n  }\n</style>\n<div class=\"ptg-board\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"ptg-mesh\" data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"animated mesh background\" data-reason=\"drift animation continuously recomputes background transform\">\n    </div>\n    <div class=\"relative z-10\" data-kid=\"1-2\" data-name=\"main content wrapper\">\n        <header class=\"ptg-container pt-8\" data-kid=\"1-2-1\" data-name=\"header section\">\n            <div class=\"ptg-nav ptg-glass flex items-center justify-between gap-5\" data-kid=\"1-2-1-1\" data-name=\"navigation bar container\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-2-1-1-1\" data-name=\"branding container\">\n                    <div class=\"ptg-brand-mark text-lg\" data-kid=\"1-2-1-1-1-1\" data-name=\"compass icon\">\n                        <i class=\"ti ti-compass\" data-kid=\"1-2-1-1-1-1-1\">\n                        </i>\n                    </div>\n                    <div class=\"ptg-brand-copy min-w-0\" data-kid=\"1-2-1-1-1-2\" data-name=\"brand name and subtitle container\">\n                        <div class=\"ptg-display truncate text-xl font-semibold tracking-[-0.04em]\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"brand title text\">\n                            Pack to Go\n                        </div>\n                        <div class=\"truncate text-[9px] uppercase tracking-[0.19em] text-[color:var(--ice)]/65\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"brand tagline text\">\n                            travel / shared / considered\n                        </div>\n                    </div>\n                </div>\n                <div class=\"ptg-nav-links flex items-center gap-1\" data-kid=\"1-2-1-1-2\" data-name=\"navigation links container\">\n                    <span class=\"ptg-nav-link ptg-nav-link-active\" data-kid=\"1-2-1-1-2-1\" data-name=\"active navigation link\">\n                        TRIPS\n                    </span>\n                    <span class=\"ptg-nav-link\" data-kid=\"1-2-1-1-2-2\" data-name=\"trips navigation link\">\n                        ITINERARY\n                    </span>\n                    <span class=\"ptg-nav-link\" data-kid=\"1-2-1-1-2-3\" data-name=\"itinerary navigation link\">\n                        BUDGET\n                    </span>\n                    <span class=\"mx-1 h-5 w-px bg-white/10\" data-kid=\"1-2-1-1-2-4\" data-name=\"separator line\">\n                    </span>\n                    <span class=\"ptg-nav-link text-white/40\" data-kid=\"1-2-1-1-2-5\" data-name=\"logout navigation link\">\n                        LOG OUT\n                    </span>\n                </div>\n            </div>\n            <div class=\"ptg-intro flex items-end justify-between gap-10\" data-kid=\"1-2-1-2\" data-name=\"introduction section\">\n                <div data-kid=\"1-2-1-2-1\" data-name=\"hero heading group\">\n                    <div class=\"ptg-kicker mb-4\" data-kid=\"1-2-1-2-1-1\" data-name=\"kicker text\">\n                        VISUAL CONCEPT BOARD / 03\n                    </div>\n                    <h1 data-kid=\"1-2-1-2-1-2\" data-name=\"hero headline text\">\n                        03 ·\n                        <em data-kid=\"1-2-1-2-1-2-1\" data-name=\"highlighted text span\">\n                            Sophisticated\n                        </em>\n                        <br data-kid=\"1-2-1-2-1-2-2\" data-name=\"line break\"/>\n                        Glassmorphism\n                    </h1>\n                </div>\n                <p class=\"ptg-intro-note mb-1\" data-kid=\"1-2-1-2-2\" data-name=\"introduction description text\">\n                    A premium travel companion shaped by depth, quiet contrast, and the soft light of an island evening.\n                </p>\n            </div>\n            <div class=\"ptg-board-meta flex items-center justify-between gap-6\" data-kid=\"1-2-1-3\" data-name=\"page metadata container\">\n                <span data-kid=\"1-2-1-3-1\" data-name=\"metadata description\">\n                    three comparable screens / one atmospheric system\n                </span>\n                <span data-kid=\"1-2-1-3-2\" data-name=\"trip location and edition info\">\n                    okinawa · 2027 / midnight edition\n                </span>\n            </div>\n        </header>\n        <main data-kid=\"1-2-2\" data-name=\"main content section\">\n            <section aria-labelledby=\"trip-stream-title\" class=\"ptg-section\" data-kid=\"1-2-2-1\" data-name=\"trip stream section\">\n                <div class=\"ptg-container\" data-kid=\"1-2-2-1-1\" data-name=\"section container\">\n                    <div class=\"ptg-section-head\" data-kid=\"1-2-2-1-1-1\" data-name=\"section header\">\n                        <div data-kid=\"1-2-2-1-1-1-1\" data-name=\"section title group\">\n                            <div class=\"ptg-screen-code\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"screen code\">\n                                01 / TRIP STREAM\n                            </div>\n                            <h2 data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"trip stream title\" id=\"trip-stream-title\">\n                                여행의 다음 장면\n                            </h2>\n                        </div>\n                        <p class=\"ptg-section-note\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"section description note\">\n                            One active journey, held in soft focus. A calm entry point for a shared trip already in motion.\n                        </p>\n                    </div>\n                    <div class=\"ptg-screen01-grid\" data-kid=\"1-2-2-1-1-2\" data-name=\"trip content grid\">\n                        <article class=\"ptg-feature ptg-glass p-2\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"featured trip card\">\n                            <div class=\"ptg-feature-media\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"trip image container\">\n                                <img alt=\"Vibrant Okinawa sunset — Hassan Rafhan on Unsplash\" data-kid=\"1-2-2-1-1-2-1-1-1\" data-name=\"trip background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1742317798833-93ea911ce2ce?auto=format&w=1400&q=80&fit=crop\"/>\n                                <div class=\"ptg-float-chip ptg-float-chip-left\" data-kid=\"1-2-2-1-1-2-1-1-2\" data-name=\"active journey label chip\">\n                                    ACTIVE JOURNEY / 01\n                                </div>\n                                <div class=\"ptg-float-chip ptg-float-chip-right\" data-kid=\"1-2-2-1-1-2-1-1-3\" data-name=\"days until trip chip\">\n                                    D-393\n                                </div>\n                                <div class=\"ptg-feature-copy\" data-kid=\"1-2-2-1-1-2-1-1-4\" data-name=\"trip details container\">\n                                    <div class=\"ptg-feature-eyebrow\" data-kid=\"1-2-2-1-1-2-1-1-4-1\" data-name=\"trip metadata eyebrow\">\n                                        OKINAWA / JAPAN · 4 NIGHTS · 2 PEOPLE\n                                    </div>\n                                    <h3 data-kid=\"1-2-2-1-1-2-1-1-4-2\" data-name=\"trip headline\">\n                                        40대의 마지막 오키나와\n                                    </h3>\n                                    <div class=\"ptg-meta-row\" data-kid=\"1-2-2-1-1-2-1-1-4-3\" data-name=\"trip meta row\">\n                                        <span data-kid=\"1-2-2-1-1-2-1-1-4-3-1\" data-name=\"location metadata\">\n                                            <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-1-1-2-1-1-4-3-1-1\" data-name=\"location icon\">\n                                            </i>\n                                            오키나와 (나하 & 차탄)\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-1-2-1-1-4-3-2\" data-name=\"calendar metadata\">\n                                            <i class=\"ti ti-calendar\" data-kid=\"1-2-2-1-1-2-1-1-4-3-2-1\" data-name=\"calendar icon\">\n                                            </i>\n                                            2027. 9. 17. — 2027. 9. 21.\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-1-2-1-1-4-3-3\" data-name=\"users metadata\">\n                                            <i class=\"ti ti-users\" data-kid=\"1-2-2-1-1-2-1-1-4-3-3-1\" data-name=\"users icon\">\n                                            </i>\n                                            멤버 2명\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </article>\n                        <aside class=\"ptg-pulse ptg-glass\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"pulse card\">\n                            <div data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"pulse info\">\n                                <div class=\"ptg-pulse-label\" data-kid=\"1-2-2-1-1-2-2-1-1\" data-name=\"pulse label\">\n                                    TRIP PULSE\n                                </div>\n                                <div class=\"ptg-pulse-number ptg-display\" data-kid=\"1-2-2-1-1-2-2-1-2\" data-name=\"pulse number text\">\n                                    393\n                                    <small data-kid=\"1-2-2-1-1-2-2-1-2-1\" data-name=\"pulse subtext\">\n                                        days out\n                                    </small>\n                                </div>\n                                <p class=\"ptg-pulse-copy\" data-kid=\"1-2-2-1-1-2-2-1-3\" data-name=\"pulse description\">\n                                    The next shared memory is already on the horizon.\n                                </p>\n                            </div>\n                            <div class=\"ptg-pulse-footer\" data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"pulse footer\">\n                                <span data-kid=\"1-2-2-1-1-2-2-2-1\" data-name=\"traveler count\">\n                                    2 travelers\n                                </span>\n                                <span class=\"ptg-teal-text\" data-kid=\"1-2-2-1-1-2-2-2-2\" data-name=\"open trip link text\">\n                                    open trip\n                                    <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-2-1-1-2-2-2-2-1\" data-name=\"arrow icon\">\n                                    </i>\n                                </span>\n                            </div>\n                        </aside>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"overview-title\" class=\"ptg-section ptg-overview\" data-kid=\"1-2-2-2\" data-name=\"overview section\">\n                <div aria-hidden=\"true\" class=\"ptg-overview-backdrop\" data-kid=\"1-2-2-2-1\" data-name=\"overview background blur\">\n                </div>\n                <div class=\"ptg-container\" data-kid=\"1-2-2-2-2\" data-name=\"overview section container\">\n                    <div class=\"ptg-section-head\" data-kid=\"1-2-2-2-2-1\" data-name=\"section header\">\n                        <div data-kid=\"1-2-2-2-2-1-1\" data-name=\"overview title group\">\n                            <div class=\"ptg-screen-code\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"screen code\">\n                                02 / IMMERSIVE OVERVIEW\n                            </div>\n                            <h2 data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"overview section title\" id=\"overview-title\">\n                                목적지의 결을 먼저 느끼다\n                            </h2>\n                        </div>\n                        <p class=\"ptg-section-note\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"overview description note\">\n                            A full-bleed island atmosphere sits behind the sharp facts that make the plan feel real.\n                        </p>\n                    </div>\n                    <div class=\"ptg-overview-hero ptg-glass\" data-kid=\"1-2-2-2-2-2\" data-name=\"overview hero card\">\n                        <div class=\"relative z-[1] flex items-end justify-between gap-8\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"hero card content container\">\n                            <div class=\"ptg-overview-title\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"overview title section\">\n                                <h2 data-kid=\"1-2-2-2-2-2-1-1-1\" data-name=\"overview title text\">\n                                    40대의 마지막 오키나와\n                                </h2>\n                                <p class=\"ptg-overview-concept mb-0\" data-kid=\"1-2-2-2-2-2-1-1-2\" data-name=\"overview concept description\">\n                                    “맛있는 일본 여행, 잔잔한 파도소리, 그리고 오키나와의 여유”\n                                </p>\n                            </div>\n                            <div class=\"ptg-fact-chips\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"fact chips container\">\n                                <span class=\"ptg-fact-chip\" data-kid=\"1-2-2-2-2-2-1-2-1\" data-name=\"date chip\">\n                                    <i class=\"ti ti-calendar\" data-kid=\"1-2-2-2-2-2-1-2-1-1\" data-name=\"calendar icon\">\n                                    </i>\n                                    2027. 9. 17 — 9. 21\n                                </span>\n                                <span class=\"ptg-fact-chip\" data-kid=\"1-2-2-2-2-2-1-2-2\" data-name=\"location chip\">\n                                    <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-2-2-2-1-2-2-1\" data-name=\"location icon\">\n                                    </i>\n                                    오키나와 (나하 & 차탄)\n                                </span>\n                                <span class=\"ptg-fact-chip\" data-kid=\"1-2-2-2-2-2-1-2-3\" data-name=\"users chip\">\n                                    <i class=\"ti ti-users\" data-kid=\"1-2-2-2-2-2-1-2-3-1\" data-name=\"users icon\">\n                                    </i>\n                                    멤버 2명\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"ptg-overview-grid\" data-kid=\"1-2-2-2-2-3\" data-name=\"overview main grid\">\n                        <div class=\"ptg-highlights\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"highlights section\">\n                            <div class=\"ptg-panel-label\" data-kid=\"1-2-2-2-2-3-1-1\" data-name=\"highlights label\">\n                                THE ISLAND, IN FOUR NOTES\n                            </div>\n                            <div class=\"ptg-highlight-grid\" data-kid=\"1-2-2-2-2-3-1-2\" data-name=\"highlights grid\">\n                                <article class=\"ptg-highlight\" data-kid=\"1-2-2-2-2-3-1-2-1\" data-name=\"first highlight item\">\n                                    <div class=\"ptg-highlight-icon ptg-cyan text-xs\" data-kid=\"1-2-2-2-2-3-1-2-1-1\" data-name=\"icon container\">\n                                        <i class=\"ti ti-sun\" data-kid=\"1-2-2-2-2-3-1-2-1-1-1\" data-name=\"sun icon\">\n                                        </i>\n                                    </div>\n                                    <h4 data-kid=\"1-2-2-2-2-3-1-2-1-2\" data-name=\"highlight title\">\n                                        에메랄드빛 아열대 낙원\n                                    </h4>\n                                    <p data-kid=\"1-2-2-2-2-3-1-2-1-3\" data-name=\"highlight description\">\n                                        일본 최남단에 위치한 아열대 기후의 섬으로, 에메랄드빛 바다와 산호초가 펼쳐진 아름다운 자연 경관을 자랑합니다.\n                                    </p>\n                                </article>\n                                <article class=\"ptg-highlight\" data-kid=\"1-2-2-2-2-3-1-2-2\" data-name=\"second highlight item\">\n                                    <div class=\"ptg-highlight-icon ptg-warm text-xs\" data-kid=\"1-2-2-2-2-3-1-2-2-1\" data-name=\"icon container\">\n                                        <i class=\"ti ti-building-castle\" data-kid=\"1-2-2-2-2-3-1-2-2-1-1\" data-name=\"castle icon\">\n                                        </i>\n                                    </div>\n                                    <h4 data-kid=\"1-2-2-2-2-3-1-2-2-2\" data-name=\"highlight title\">\n                                        독자적인 류큐 왕국의 숨결\n                                    </h4>\n                                    <p data-kid=\"1-2-2-2-2-3-1-2-2-3\" data-name=\"highlight description\">\n                                        과거 류큐 왕국 시대의 독자적인 역사와 문화를 간직하고 있어, 일본 본토와는 다른 이국적인 분위기를 느낄 수 있습니다.\n                                    </p>\n                                </article>\n                                <article class=\"ptg-highlight\" data-kid=\"1-2-2-2-2-3-1-2-3\" data-name=\"third highlight item\">\n                                    <div class=\"ptg-highlight-icon ptg-coral text-xs\" data-kid=\"1-2-2-2-2-3-1-2-3-1\" data-name=\"icon container\">\n                                        <i class=\"ti ti-coffee\" data-kid=\"1-2-2-2-2-3-1-2-3-1-1\" data-name=\"coffee icon\">\n                                        </i>\n                                    </div>\n                                    <h4 data-kid=\"1-2-2-2-2-3-1-2-3-2\" data-name=\"highlight title\">\n                                        동서양이 만나는 문화 융합\n                                    </h4>\n                                    <p data-kid=\"1-2-2-2-2-3-1-2-3-3\" data-name=\"highlight description\">\n                                        미군의 영향으로 형성된 아메리칸 빌리지 등 독특한 사회적 융합 문화가 곳곳에 스며들어 있어 색다른 볼거리를 제공합니다.\n                                    </p>\n                                </article>\n                                <article class=\"ptg-highlight\" data-kid=\"1-2-2-2-2-3-1-2-4\" data-name=\"fourth highlight item\">\n                                    <div class=\"ptg-highlight-icon ptg-mint text-xs\" data-kid=\"1-2-2-2-2-3-1-2-4-1\" data-name=\"icon container\">\n                                        <i class=\"ti ti-leaf\" data-kid=\"1-2-2-2-2-3-1-2-4-1-1\" data-name=\"leaf icon\">\n                                        </i>\n                                    </div>\n                                    <h4 data-kid=\"1-2-2-2-2-3-1-2-4-2\" data-name=\"highlight title\">\n                                        사계절 내내 완벽한 휴양\n                                    </h4>\n                                    <p data-kid=\"1-2-2-2-2-3-1-2-4-3\" data-name=\"highlight description\">\n                                        세계적인 수준의 다이빙 포인트와 따뜻한 날씨 덕분에 해양 스포츠와 휴양을 즐기기에 최적의 조건을 갖추고 있습니다.\n                                    </p>\n                                </article>\n                            </div>\n                            <div class=\"ptg-weather-row\" data-kid=\"1-2-2-2-2-3-1-3\" data-name=\"weather row container\">\n                                <div class=\"ptg-weather-item\" data-kid=\"1-2-2-2-2-3-1-3-1\" data-name=\"weather item\">\n                                    <i class=\"ti ti-sun-high ptg-warm\" data-kid=\"1-2-2-2-2-3-1-3-1-1\" data-name=\"sun icon\">\n                                    </i>\n                                    예상 날씨\n                                    <strong data-kid=\"1-2-2-2-2-3-1-3-1-2\" data-name=\"weather forecast bold text\">\n                                        평균 기온 20도, 맑고 화창한 봄 날씨\n                                    </strong>\n                                    <span data-kid=\"1-2-2-2-2-3-1-3-1-3\" data-name=\"weather forecast detail\">\n                                        (가끔 흐림)\n                                    </span>\n                                </div>\n                                <div class=\"ptg-weather-item\" data-kid=\"1-2-2-2-2-3-1-3-2\" data-name=\"clothing item\">\n                                    <i class=\"ti ti-shirt ptg-ice\" data-kid=\"1-2-2-2-2-3-1-3-2-1\" data-name=\"shirt icon\">\n                                    </i>\n                                    추천 복장\n                                    <strong data-kid=\"1-2-2-2-2-3-1-3-2-2\" data-name=\"clothing recommendation bold text\">\n                                        반팔 위주의 가벼운 옷차림\n                                    </strong>\n                                    <span data-kid=\"1-2-2-2-2-3-1-3-2-3\" data-name=\"clothing recommendation detail\">\n                                        저녁을 위한 가벼운 외투\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"ptg-overview-side\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"overview side panel\">\n                            <div class=\"ptg-map-panel ptg-glass\" data-kid=\"1-2-2-2-2-3-2-1\" data-name=\"map panel\">\n                                <div aria-hidden=\"true\" class=\"ptg-map-canvas\" data-kid=\"1-2-2-2-2-3-2-1-1\" data-name=\"map canvas background\">\n                                    <div class=\"ptg-map-route\" data-kid=\"1-2-2-2-2-3-2-1-1-1\" data-name=\"map route line\">\n                                    </div>\n                                    <span class=\"ptg-map-dot ptg-map-dot-one\" data-kid=\"1-2-2-2-2-3-2-1-1-2\" data-name=\"first map location dot\">\n                                    </span>\n                                    <span class=\"ptg-map-dot ptg-map-dot-two\" data-kid=\"1-2-2-2-2-3-2-1-1-3\" data-name=\"second map location dot\">\n                                    </span>\n                                </div>\n                                <i class=\"ptg-map-pin ti ti-map-pin\" data-kid=\"1-2-2-2-2-3-2-1-2\" data-name=\"map pin icon\">\n                                </i>\n                                <div class=\"ptg-map-copy\" data-kid=\"1-2-2-2-2-3-2-1-3\" data-name=\"map description container\">\n                                    <small data-kid=\"1-2-2-2-2-3-2-1-3-1\" data-name=\"map label\">\n                                        CHatan, Okinawa / MAP\n                                    </small>\n                                    <h3 data-kid=\"1-2-2-2-2-3-2-1-3-2\" data-name=\"map title\">\n                                        동쪽으로 기울어진 섬\n                                    </h3>\n                                </div>\n                            </div>\n                            <div class=\"ptg-member ptg-glass\" data-kid=\"1-2-2-2-2-3-2-2\" data-name=\"member info card\">\n                                <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-2-3-2-2-1\" data-name=\"member details container\">\n                                    <div class=\"ptg-avatar\" data-kid=\"1-2-2-2-2-3-2-2-1-1\" data-name=\"member avatar\">\n                                        영\n                                    </div>\n                                    <div data-kid=\"1-2-2-2-2-3-2-2-1-2\" data-name=\"member label/name container\">\n                                        <div class=\"ptg-member-label\" data-kid=\"1-2-2-2-2-3-2-2-1-2-1\" data-name=\"member label\">\n                                            TRAVELLING WITH\n                                        </div>\n                                        <div class=\"ptg-member-name\" data-kid=\"1-2-2-2-2-3-2-2-1-2-2\" data-name=\"member name\">\n                                            영숙 · Dev User\n                                        </div>\n                                    </div>\n                                </div>\n                                <i class=\"ti ti-arrow-up-right ptg-teal-text text-base\" data-kid=\"1-2-2-2-2-3-2-2-2\" data-name=\"member action icon\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                    <div aria-label=\"Okinawa gallery\" class=\"ptg-gallery\" data-kid=\"1-2-2-2-2-4\" data-name=\"gallery container\">\n                        <figure class=\"ptg-gallery-figure ptg-gallery-one\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"gallery image one\">\n                            <img alt=\"Okinawa gallery view one\" data-kid=\"1-2-2-2-2-4-1-1\" data-name=\"gallery photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/gallery/1.jpg\"/>\n                            <figcaption data-kid=\"1-2-2-2-2-4-1-2\" data-name=\"gallery caption\">\n                                01 / shoreline light\n                            </figcaption>\n                        </figure>\n                        <figure class=\"ptg-gallery-figure ptg-gallery-two\" data-kid=\"1-2-2-2-2-4-2\" data-name=\"gallery image two\">\n                            <img alt=\"Okinawa gallery view two\" data-kid=\"1-2-2-2-2-4-2-1\" data-name=\"gallery photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/gallery/2.png\"/>\n                            <figcaption data-kid=\"1-2-2-2-2-4-2-2\" data-name=\"gallery caption\">\n                                02 / slow afternoon\n                            </figcaption>\n                        </figure>\n                        <figure class=\"ptg-gallery-figure ptg-gallery-three\" data-kid=\"1-2-2-2-2-4-3\" data-name=\"gallery image three\">\n                            <img alt=\"Okinawa gallery view three\" data-kid=\"1-2-2-2-2-4-3-1\" data-name=\"gallery photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/gallery/3.jpg\"/>\n                            <figcaption data-kid=\"1-2-2-2-2-4-3-2\" data-name=\"gallery caption\">\n                                03 / afterglow\n                            </figcaption>\n                        </figure>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"itinerary-title\" class=\"ptg-section\" data-kid=\"1-2-2-3\" data-name=\"itinerary section\">\n                <div class=\"ptg-container\" data-kid=\"1-2-2-3-1\" data-name=\"itinerary container\">\n                    <div class=\"ptg-section-head ptg-itinerary-head\" data-kid=\"1-2-2-3-1-1\" data-name=\"itinerary section head\">\n                        <div data-kid=\"1-2-2-3-1-1-1\" data-name=\"itinerary title group\">\n                            <div class=\"ptg-screen-code\" data-kid=\"1-2-2-3-1-1-1-1\" data-name=\"screen code\">\n                                03 / FLOATING ITINERARY + BUDGET\n                            </div>\n                            <h2 data-kid=\"1-2-2-3-1-1-1-2\" data-name=\"itinerary section title\" id=\"itinerary-title\">\n                                Make room for the in-between\n                            </h2>\n                        </div>\n                        <p class=\"ptg-section-note\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"itinerary section description\">\n                            A shared day with enough structure to move, and enough air to stay present.\n                        </p>\n                    </div>\n                    <div class=\"ptg-day-tabs ptg-glass\" data-kid=\"1-2-2-3-1-2\" data-name=\"day tabs container\">\n                        <div class=\"ptg-day-tab ptg-day-tab-active\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"day one active tab\">\n                            DAY 01\n                            <small data-kid=\"1-2-2-3-1-2-1-1\" data-name=\"day date\">\n                                9. 17. FRI\n                            </small>\n                        </div>\n                        <div class=\"ptg-day-tab\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"day two tab\">\n                            DAY 02\n                            <small data-kid=\"1-2-2-3-1-2-2-1\" data-name=\"day date\">\n                                9. 18. SAT\n                            </small>\n                        </div>\n                        <div class=\"ptg-day-tab\" data-kid=\"1-2-2-3-1-2-3\" data-name=\"day three tab\">\n                            DAY 03\n                            <small data-kid=\"1-2-2-3-1-2-3-1\" data-name=\"day date\">\n                                9. 19. SUN\n                            </small>\n                        </div>\n                        <div class=\"ptg-day-tab\" data-kid=\"1-2-2-3-1-2-4\" data-name=\"day four tab\">\n                            DAY 04\n                            <small data-kid=\"1-2-2-3-1-2-4-1\" data-name=\"day date\">\n                                9. 20. MON\n                            </small>\n                        </div>\n                    </div>\n                    <div class=\"ptg-screen03-grid\" data-kid=\"1-2-2-3-1-3\" data-name=\"screen three grid\">\n                        <div class=\"ptg-timeline-panel\" data-kid=\"1-2-2-3-1-3-1\" data-name=\"timeline panel\">\n                            <div class=\"ptg-timeline-heading\" data-kid=\"1-2-2-3-1-3-1-1\" data-name=\"timeline heading\">\n                                <span data-kid=\"1-2-2-3-1-3-1-1-1\" data-name=\"timeline date text\">\n                                    FRIDAY, SEPTEMBER 17\n                                </span>\n                                <i class=\"ti ti-chevron-down ptg-icon-ice text-sm\" data-kid=\"1-2-2-3-1-3-1-1-2\" data-name=\"timeline chevron icon\">\n                                </i>\n                            </div>\n                            <div class=\"ptg-timeline\" data-kid=\"1-2-2-3-1-3-1-2\" data-name=\"timeline list\">\n                                <article class=\"ptg-timeline-row\" data-kid=\"1-2-2-3-1-3-1-2-1\" data-name=\"first timeline event\">\n                                    <div class=\"ptg-time\" data-kid=\"1-2-2-3-1-3-1-2-1-1\" data-name=\"event time container\">\n                                        <i class=\"ti ti-clock\" data-kid=\"1-2-2-3-1-3-1-2-1-1-1\" data-name=\"clock icon\">\n                                        </i>\n                                        11:00 AM\n                                    </div>\n                                    <h3 data-kid=\"1-2-2-3-1-3-1-2-1-2\" data-name=\"event title\">\n                                        오키나와 나하 공항 도착\n                                    </h3>\n                                    <div class=\"ptg-location\" data-kid=\"1-2-2-3-1-3-1-2-1-3\" data-name=\"event location container\">\n                                        <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-3-1-3-1-2-1-3-1\" data-name=\"map pin icon\">\n                                        </i>\n                                        나하 공항\n                                    </div>\n                                </article>\n                                <article class=\"ptg-timeline-row\" data-kid=\"1-2-2-3-1-3-1-2-2\" data-name=\"second timeline event\">\n                                    <div class=\"ptg-time\" data-kid=\"1-2-2-3-1-3-1-2-2-1\" data-name=\"event time container\">\n                                        <i class=\"ti ti-clock\" data-kid=\"1-2-2-3-1-3-1-2-2-1-1\" data-name=\"clock icon\">\n                                        </i>\n                                        01:00 PM\n                                    </div>\n                                    <h3 data-kid=\"1-2-2-3-1-3-1-2-2-2\" data-name=\"event title\">\n                                        우미카지 테라스 점심\n                                    </h3>\n                                    <div class=\"ptg-location\" data-kid=\"1-2-2-3-1-3-1-2-2-3\" data-name=\"event location container\">\n                                        <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-3-1-3-1-2-2-3-1\" data-name=\"map pin icon\">\n                                        </i>\n                                        우미카지 테라스\n                                    </div>\n                                </article>\n                                <article class=\"ptg-timeline-row\" data-kid=\"1-2-2-3-1-3-1-2-3\" data-name=\"third timeline event\">\n                                    <div class=\"ptg-time\" data-kid=\"1-2-2-3-1-3-1-2-3-1\" data-name=\"event time container\">\n                                        <i class=\"ti ti-clock\" data-kid=\"1-2-2-3-1-3-1-2-3-1-1\" data-name=\"clock icon\">\n                                        </i>\n                                        03:30 PM\n                                    </div>\n                                    <h3 data-kid=\"1-2-2-3-1-3-1-2-3-2\" data-name=\"event title\">\n                                        국제거리 호텔 체크인\n                                    </h3>\n                                    <div class=\"ptg-location\" data-kid=\"1-2-2-3-1-3-1-2-3-3\" data-name=\"event location container\">\n                                        <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-3-1-3-1-2-3-3-1\" data-name=\"map pin icon\">\n                                        </i>\n                                        하얏트 리젠시 나하\n                                    </div>\n                                </article>\n                                <article class=\"ptg-timeline-row\" data-kid=\"1-2-2-3-1-3-1-2-4\" data-name=\"fourth timeline event\">\n                                    <div class=\"ptg-time\" data-kid=\"1-2-2-3-1-3-1-2-4-1\" data-name=\"event time container\">\n                                        <i class=\"ti ti-clock\" data-kid=\"1-2-2-3-1-3-1-2-4-1-1\" data-name=\"clock icon\">\n                                        </i>\n                                        07:00 PM\n                                    </div>\n                                    <h3 data-kid=\"1-2-2-3-1-3-1-2-4-2\" data-name=\"event title\">\n                                        철판구이 스테이크 만찬\n                                    </h3>\n                                    <div class=\"ptg-location\" data-kid=\"1-2-2-3-1-3-1-2-4-3\" data-name=\"event location container\">\n                                        <i class=\"ti ti-map-pin\" data-kid=\"1-2-2-3-1-3-1-2-4-3-1\" data-name=\"map pin icon\">\n                                        </i>\n                                        국제거리 테판야키 식당\n                                    </div>\n                                </article>\n                            </div>\n                        </div>\n                        <div class=\"ptg-budget-panel ptg-glass\" data-kid=\"1-2-2-3-1-3-2\" data-name=\"budget panel\">\n                            <div class=\"ptg-budget-top\" data-kid=\"1-2-2-3-1-3-2-1\" data-name=\"budget top section\">\n                                <div data-kid=\"1-2-2-3-1-3-2-1-1\" data-name=\"budget total info\">\n                                    <div class=\"ptg-budget-label\" data-kid=\"1-2-2-3-1-3-2-1-1-1\" data-name=\"budget label\">\n                                        SHARED BUDGET\n                                    </div>\n                                    <div class=\"ptg-budget-total\" data-kid=\"1-2-2-3-1-3-2-1-1-2\" data-name=\"budget total text\">\n                                        6,000,000\n                                        <span data-kid=\"1-2-2-3-1-3-2-1-1-2-1\" data-name=\"budget total subtext\">\n                                            원 total\n                                        </span>\n                                    </div>\n                                </div>\n                                <i class=\"ptg-budget-icon ti ti-wallet\" data-kid=\"1-2-2-3-1-3-2-1-2\" data-name=\"budget wallet icon\">\n                                </i>\n                            </div>\n                            <div class=\"ptg-budget-ring-wrap\" data-kid=\"1-2-2-3-1-3-2-2\" data-name=\"budget ring graph container\">\n                                <div class=\"ptg-budget-ring\" data-kid=\"1-2-2-3-1-3-2-2-1\" data-name=\"budget ring graph\">\n                                    <div class=\"ptg-budget-ring-inner\" data-kid=\"1-2-2-3-1-3-2-2-1-1\" data-name=\"budget ring inner content\">\n                                        <div data-kid=\"1-2-2-3-1-3-2-2-1-1-1\" data-name=\"budget ring content details\">\n                                            <div class=\"ptg-budget-ring-number\" data-kid=\"1-2-2-3-1-3-2-2-1-1-1-1\" data-name=\"percentage text\">\n                                                95\n                                                <span data-kid=\"1-2-2-3-1-3-2-2-1-1-1-1-1\" data-name=\"percentage symbol\">\n                                                    %\n                                                </span>\n                                            </div>\n                                            <div class=\"ptg-budget-ring-caption\" data-kid=\"1-2-2-3-1-3-2-2-1-1-1-2\" data-name=\"budget caption\">\n                                                USED\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"ptg-budget-stats\" data-kid=\"1-2-2-3-1-3-2-3\" data-name=\"budget stats container\">\n                                <div class=\"ptg-budget-stat\" data-kid=\"1-2-2-3-1-3-2-3-1\" data-name=\"spent budget stat\">\n                                    <small data-kid=\"1-2-2-3-1-3-2-3-1-1\" data-name=\"spent label\">\n                                        Spent\n                                    </small>\n                                    <strong data-kid=\"1-2-2-3-1-3-2-3-1-2\" data-name=\"spent amount\">\n                                        5,700,000원\n                                    </strong>\n                                </div>\n                                <div class=\"ptg-budget-stat\" data-kid=\"1-2-2-3-1-3-2-3-2\" data-name=\"remaining budget stat\">\n                                    <small data-kid=\"1-2-2-3-1-3-2-3-2-1\" data-name=\"remaining label\">\n                                        Remaining\n                                    </small>\n                                    <strong data-kid=\"1-2-2-3-1-3-2-3-2-2\" data-name=\"remaining amount\">\n                                        300,000원\n                                    </strong>\n                                </div>\n                            </div>\n                            <div class=\"ptg-expenses\" data-kid=\"1-2-2-3-1-3-2-4\" data-name=\"expenses list container\">\n                                <div class=\"ptg-expense-row\" data-kid=\"1-2-2-3-1-3-2-4-1\" data-name=\"first expense row\">\n                                    <span class=\"ptg-expense-name\" data-kid=\"1-2-2-3-1-3-2-4-1-1\" data-name=\"expense name\">\n                                        <i class=\"ti ti-bed\" data-kid=\"1-2-2-3-1-3-2-4-1-1-1\" data-name=\"bed icon\">\n                                        </i>\n                                        숙박\n                                        <em class=\"ptg-expense-payer\" data-kid=\"1-2-2-3-1-3-2-4-1-1-2\" data-name=\"payer label\">\n                                            영숙\n                                        </em>\n                                    </span>\n                                    <b class=\"ptg-expense-amount\" data-kid=\"1-2-2-3-1-3-2-4-1-2\" data-name=\"expense amount\">\n                                        2,000,000원\n                                    </b>\n                                </div>\n                                <div class=\"ptg-expense-row\" data-kid=\"1-2-2-3-1-3-2-4-2\" data-name=\"second expense row\">\n                                    <span class=\"ptg-expense-name\" data-kid=\"1-2-2-3-1-3-2-4-2-1\" data-name=\"expense name\">\n                                        <i class=\"ti ti-plane\" data-kid=\"1-2-2-3-1-3-2-4-2-1-1\" data-name=\"plane icon\">\n                                        </i>\n                                        항공\n                                        <em class=\"ptg-expense-payer\" data-kid=\"1-2-2-3-1-3-2-4-2-1-2\" data-name=\"payer label\">\n                                            영숙\n                                        </em>\n                                    </span>\n                                    <b class=\"ptg-expense-amount\" data-kid=\"1-2-2-3-1-3-2-4-2-2\" data-name=\"expense amount\">\n                                        1,500,000원\n                                    </b>\n                                </div>\n                                <div class=\"ptg-expense-row\" data-kid=\"1-2-2-3-1-3-2-4-3\" data-name=\"third expense row\">\n                                    <span class=\"ptg-expense-name\" data-kid=\"1-2-2-3-1-3-2-4-3-1\" data-name=\"expense name\">\n                                        <i class=\"ti ti-tools-kitchen-2\" data-kid=\"1-2-2-3-1-3-2-4-3-1-1\" data-name=\"kitchen icon\">\n                                        </i>\n                                        식비\n                                        <em class=\"ptg-expense-payer\" data-kid=\"1-2-2-3-1-3-2-4-3-1-2\" data-name=\"payer label\">\n                                            영숙\n                                        </em>\n                                    </span>\n                                    <b class=\"ptg-expense-amount\" data-kid=\"1-2-2-3-1-3-2-4-3-2\" data-name=\"expense amount\">\n                                        1,200,000원\n                                    </b>\n                                </div>\n                                <div class=\"ptg-expense-row\" data-kid=\"1-2-2-3-1-3-2-4-4\" data-name=\"fourth expense row\">\n                                    <span class=\"ptg-expense-name\" data-kid=\"1-2-2-3-1-3-2-4-4-1\" data-name=\"expense name\">\n                                        <i class=\"ti ti-car\" data-kid=\"1-2-2-3-1-3-2-4-4-1-1\" data-name=\"car icon\">\n                                        </i>\n                                        교통\n                                        <em class=\"ptg-expense-payer\" data-kid=\"1-2-2-3-1-3-2-4-4-1-2\" data-name=\"payer label\">\n                                            영숙\n                                        </em>\n                                    </span>\n                                    <b class=\"ptg-expense-amount\" data-kid=\"1-2-2-3-1-3-2-4-4-2\" data-name=\"expense amount\">\n                                        400,000원\n                                    </b>\n                                </div>\n                                <div class=\"ptg-expense-row\" data-kid=\"1-2-2-3-1-3-2-4-5\" data-name=\"fifth expense row\">\n                                    <span class=\"ptg-expense-name\" data-kid=\"1-2-2-3-1-3-2-4-5-1\" data-name=\"expense name\">\n                                        <i class=\"ti ti-sparkles\" data-kid=\"1-2-2-3-1-3-2-4-5-1-1\" data-name=\"sparkles icon\">\n                                        </i>\n                                        액티비티\n                                        <em class=\"ptg-expense-payer\" data-kid=\"1-2-2-3-1-3-2-4-5-1-2\" data-name=\"payer label\">\n                                            영숙\n                                        </em>\n                                    </span>\n                                    <b class=\"ptg-expense-amount\" data-kid=\"1-2-2-3-1-3-2-4-5-2\" data-name=\"expense amount\">\n                                        300,000원\n                                    </b>\n                                </div>\n                                <div class=\"ptg-expense-row\" data-kid=\"1-2-2-3-1-3-2-4-6\" data-name=\"sixth expense row\">\n                                    <span class=\"ptg-expense-name\" data-kid=\"1-2-2-3-1-3-2-4-6-1\" data-name=\"expense name\">\n                                        <i class=\"ti ti-shopping-bag\" data-kid=\"1-2-2-3-1-3-2-4-6-1-1\" data-name=\"shopping bag icon\">\n                                        </i>\n                                        쇼핑\n                                        <em class=\"ptg-expense-payer\" data-kid=\"1-2-2-3-1-3-2-4-6-1-2\" data-name=\"payer label\">\n                                            영숙\n                                        </em>\n                                    </span>\n                                    <b class=\"ptg-expense-amount\" data-kid=\"1-2-2-3-1-3-2-4-6-2\" data-name=\"expense amount\">\n                                        300,000원\n                                    </b>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </main>\n        <footer class=\"ptg-container ptg-footer\" data-kid=\"1-2-3\" data-name=\"footer section\">\n            <strong data-kid=\"1-2-3-1\" data-name=\"footer brand text\">\n                PACK TO GO / CONCEPT 03 — atmospheric companion\n            </strong>\n            <span data-kid=\"1-2-3-2\" data-name=\"footer copyright info\">\n                shared plans · softer edges · okinawa / 2027\n            </span>\n        </footer>\n    </div>\n</div>\n",
