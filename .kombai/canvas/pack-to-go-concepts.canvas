      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n#concept-board {\n  --paper: #F4F1ED;\n  --surface: #FFFFFF;\n  --ink: #333333;\n  --taupe: #8C867C;\n  --line: #DDD7CF;\n  --accent: #D96C4A;\n  --mist: #EBE7E0;\n  color: var(--ink);\n  background: var(--paper);\n  font-family: 'Inter', sans-serif;\n  width: 100%;\n  max-width: 1440px;\n  min-height: 100vh;\n  margin: 0 auto;\n  padding: 30px 48px 52px;\n  overflow-x: clip;\n}\n\n#concept-board .mono {\n  font-family: 'Roboto Mono', monospace;\n}\n\n#concept-board .hairline {\n  border-color: var(--line);\n}\n\n#concept-board .eyebrow {\n  color: var(--accent);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: .16em;\n  line-height: 1.4;\n  text-transform: uppercase;\n}\n\n#concept-board .muted {\n  color: var(--taupe);\n}\n\n#concept-board .board-header {\n  min-height: 52px;\n  border-bottom: 1px solid var(--line);\n}\n\n#concept-board .brand-rule {\n  align-items: center;\n  background: transparent;\n  color: var(--accent);\n  display: flex;\n  height: 20px;\n  justify-content: center;\n  width: 20px;\n}\n\n#concept-board .quiet-nav span {\n  border-bottom: 1px solid transparent;\n  color: var(--taupe);\n  font-size: 10px;\n  letter-spacing: .13em;\n  line-height: 28px;\n  text-transform: uppercase;\n}\n\n#concept-board .quiet-nav span:first-child {\n  color: var(--ink);\n  border-bottom-color: var(--accent);\n}\n\n#concept-board .board-masthead {\n  min-height: 154px;\n  border-bottom: 1px solid var(--line);\n  padding: 42px 0 34px;\n}\n\n#concept-board .board-masthead h1 {\n  color: var(--ink);\n  font-size: clamp(26px, 3vw, 40px);\n  font-weight: 600;\n  letter-spacing: -.055em;\n  line-height: 1.05;\n}\n\n#concept-board .masthead-note {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 10px;\n  letter-spacing: .08em;\n  line-height: 1.8;\n  text-align: right;\n  text-transform: uppercase;\n}\n\n#concept-board .screen-section {\n  border-top: 1px solid var(--line);\n  padding-top: 54px;\n}\n\n#concept-board .screen-section.screen-one {\n  border-top: 0;\n}\n\n#concept-board .section-heading {\n  align-items: flex-end;\n  display: flex;\n  justify-content: space-between;\n  gap: 32px;\n}\n\n#concept-board .section-heading h2 {\n  color: var(--ink);\n  font-size: 34px;\n  font-weight: 600;\n  letter-spacing: -.055em;\n  line-height: 1.1;\n}\n\n#concept-board .section-heading .descriptor {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 11px;\n  letter-spacing: .1em;\n  line-height: 1.4;\n  text-align: right;\n  text-transform: uppercase;\n}\n\n#concept-board .section-caption {\n  color: var(--taupe);\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n#concept-board .dossier-table {\n  background: var(--surface);\n  border-bottom: 1px solid var(--line);\n  border-top: 1px solid var(--line);\n  overflow-x: auto;\n}\n\n#concept-board .dossier-table-head,\n#concept-board .dossier-table-row {\n  align-items: center;\n  display: grid;\n  grid-template-columns: minmax(320px, 1.5fr) minmax(210px, 1.05fr) minmax(235px, 1.2fr) minmax(165px, .85fr) 90px;\n  min-width: 1100px;\n}\n\n#concept-board .dossier-table-head {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .14em;\n  min-height: 42px;\n  padding: 0 24px;\n  text-transform: uppercase;\n}\n\n#concept-board .dossier-table-row {\n  border-left: 3px solid var(--accent);\n  min-height: 126px;\n  padding: 22px 24px 22px 21px;\n}\n\n#concept-board .dossier-table-row > div,\n#concept-board .dossier-table-row > p {\n  min-width: 0;\n}\n\n#concept-board .trip-primary {\n  align-items: center;\n  display: flex;\n  gap: 18px;\n}\n\n#concept-board .trip-thumb {\n  background: var(--mist);\n  display: block;\n  flex: 0 0 auto;\n  height: 76px;\n  object-fit: cover;\n  width: 76px;\n}\n\n#concept-board .trip-title {\n  font-size: 15px;\n  font-weight: 600;\n  letter-spacing: -.02em;\n  line-height: 1.35;\n}\n\n#concept-board .trip-meta {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .1em;\n  line-height: 1.5;\n  margin-top: 9px;\n  text-transform: uppercase;\n}\n\n#concept-board .dossier-value {\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n#concept-board .dossier-subvalue {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 10px;\n  line-height: 1.5;\n  margin-top: 6px;\n}\n\n#concept-board .status-cell {\n  align-items: center;\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n}\n\n#concept-board .status-cell .status {\n  color: var(--accent);\n  font-size: 12px;\n  font-weight: 500;\n}\n\n#concept-board .screen-two {\n  margin-top: 84px;\n}\n\n#concept-board .overview-head {\n  align-items: start;\n  display: grid;\n  gap: 48px;\n  grid-template-columns: minmax(0, 1fr) 312px;\n}\n\n#concept-board .overview-title {\n  color: var(--ink);\n  font-size: clamp(34px, 4.2vw, 58px);\n  font-weight: 600;\n  letter-spacing: -.07em;\n  line-height: 1.02;\n  max-width: 760px;\n}\n\n#concept-board .concept-line {\n  color: var(--taupe);\n  font-size: 14px;\n  line-height: 1.6;\n  margin-top: 17px;\n}\n\n#concept-board .fact-column {\n  border-left: 1px solid var(--line);\n  padding-left: 26px;\n}\n\n#concept-board .fact-row {\n  border-bottom: 1px solid var(--line);\n  padding: 0 0 15px;\n  margin-bottom: 15px;\n}\n\n#concept-board .fact-row:last-child {\n  border-bottom: 0;\n  margin-bottom: 0;\n  padding-bottom: 0;\n}\n\n#concept-board .fact-row dt {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .13em;\n  line-height: 1.5;\n  text-transform: uppercase;\n}\n\n#concept-board .fact-row dd {\n  font-size: 12px;\n  line-height: 1.5;\n  margin-top: 4px;\n}\n\n#concept-board .destination-figure {\n  margin: 38px 0 0;\n}\n\n#concept-board .destination-image {\n  background: var(--mist);\n  display: block;\n  height: 330px;\n  object-fit: cover;\n  width: 100%;\n}\n\n#concept-board .image-caption {\n  align-items: center;\n  border-bottom: 1px solid var(--line);\n  color: var(--taupe);\n  display: flex;\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  justify-content: space-between;\n  letter-spacing: .1em;\n  padding: 11px 0 12px;\n  text-transform: uppercase;\n}\n\n#concept-board .overview-split {\n  display: grid;\n  gap: 54px;\n  grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);\n  margin-top: 42px;\n}\n\n#concept-board .narrative-title {\n  font-size: 25px;\n  font-weight: 600;\n  letter-spacing: -.045em;\n  line-height: 1.2;\n}\n\n#concept-board .narrative-copy {\n  color: var(--taupe);\n  font-size: 13px;\n  line-height: 1.8;\n  max-width: 710px;\n  margin-top: 15px;\n}\n\n#concept-board .highlight-list {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin-top: 30px;\n}\n\n#concept-board .highlight-item {\n  border-bottom: 1px solid var(--line);\n  display: grid;\n  gap: 15px;\n  grid-template-columns: 32px minmax(0, 1fr);\n  padding: 18px 18px 19px 0;\n}\n\n#concept-board .highlight-item:nth-child(odd) {\n  border-right: 1px solid var(--line);\n  padding-right: 24px;\n}\n\n#concept-board .highlight-item:nth-child(even) {\n  padding-left: 24px;\n}\n\n#concept-board .highlight-item:nth-child(-n+2) {\n  border-top: 1px solid var(--line);\n}\n\n#concept-board .highlight-number {\n  color: var(--accent);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 10px;\n  line-height: 1.4;\n  padding-top: 2px;\n}\n\n#concept-board .highlight-copy h4 {\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: -.015em;\n  line-height: 1.4;\n}\n\n#concept-board .highlight-copy p {\n  color: var(--taupe);\n  font-size: 11px;\n  line-height: 1.65;\n  margin-top: 6px;\n}\n\n#concept-board .highlight-check {\n  color: var(--accent);\n  font-size: 12px;\n  margin-left: 6px;\n}\n\n#concept-board .overview-aside {\n  border-left: 1px solid var(--line);\n  padding-left: 30px;\n}\n\n#concept-board .map-placeholder {\n  background-color: var(--mist);\n  background-image: linear-gradient(rgba(140, 134, 124, .14) 1px, transparent 1px), linear-gradient(90deg, rgba(140, 134, 124, .14) 1px, transparent 1px);\n  background-size: 36px 36px;\n  height: 226px;\n  overflow: hidden;\n  padding: 16px;\n  position: relative;\n}\n\n#concept-board .map-placeholder::after {\n  border: 1px solid rgba(140, 134, 124, .22);\n  content: '';\n  inset: 14px;\n  pointer-events: none;\n  position: absolute;\n}\n\n#concept-board .map-label {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .1em;\n  position: relative;\n  text-transform: uppercase;\n  z-index: 2;\n}\n\n#concept-board .map-path {\n  height: 100%;\n  inset: 0;\n  position: absolute;\n  width: 100%;\n}\n\n#concept-board .map-path path {\n  fill: none;\n  stroke: rgba(140, 134, 124, .6);\n  stroke-dasharray: 2 5;\n  stroke-linecap: round;\n  stroke-width: 1;\n  vector-effect: non-scaling-stroke;\n}\n\n#concept-board .map-marker {\n  align-items: center;\n  background: var(--accent);\n  color: var(--surface);\n  display: flex;\n  height: 27px;\n  justify-content: center;\n  left: 59%;\n  position: absolute;\n  top: 93px;\n  width: 27px;\n  z-index: 2;\n}\n\n#concept-board .map-marker::after {\n  border-left: 5px solid transparent;\n  border-right: 5px solid transparent;\n  border-top: 6px solid var(--accent);\n  bottom: -6px;\n  content: '';\n  left: 8px;\n  position: absolute;\n}\n\n#concept-board .map-marker i {\n  font-size: 14px;\n}\n\n#concept-board .map-coordinate {\n  bottom: 16px;\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 8px;\n  letter-spacing: .06em;\n  position: absolute;\n  right: 16px;\n}\n\n#concept-board .aside-rows {\n  border-top: 1px solid var(--line);\n  margin-top: 24px;\n}\n\n#concept-board .aside-row {\n  align-items: start;\n  border-bottom: 1px solid var(--line);\n  display: grid;\n  gap: 14px;\n  grid-template-columns: 108px minmax(0, 1fr);\n  padding: 15px 0;\n}\n\n#concept-board .aside-row dt {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .08em;\n  line-height: 1.5;\n  text-transform: uppercase;\n}\n\n#concept-board .aside-row dd {\n  font-size: 11px;\n  line-height: 1.6;\n  text-align: right;\n}\n\n#concept-board .gallery-strip {\n  margin-top: 43px;\n}\n\n#concept-board .gallery-head {\n  align-items: center;\n  border-top: 1px solid var(--line);\n  display: flex;\n  justify-content: space-between;\n  padding-top: 15px;\n}\n\n#concept-board .gallery-grid {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: 1.35fr 1fr 1fr;\n  margin-top: 14px;\n}\n\n#concept-board .gallery-item {\n  margin: 0;\n  min-width: 0;\n}\n\n#concept-board .gallery-image-shell {\n  background: var(--mist);\n  height: 156px;\n  overflow: hidden;\n}\n\n#concept-board .gallery-image-shell img {\n  display: block;\n  height: 100%;\n  object-fit: cover;\n  width: 100%;\n}\n\n#concept-board .gallery-item figcaption {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .08em;\n  padding-top: 9px;\n  text-transform: uppercase;\n}\n\n#concept-board .screen-three {\n  margin-top: 84px;\n}\n\n#concept-board .planning-layout {\n  display: grid;\n  gap: 54px;\n  grid-template-columns: minmax(0, 1.12fr) minmax(480px, .88fr);\n  margin-top: 42px;\n}\n\n#concept-board .date-tabs {\n  align-items: stretch;\n  border-bottom: 1px solid var(--line);\n  display: flex;\n  gap: 30px;\n  overflow-x: auto;\n  white-space: nowrap;\n}\n\n#concept-board .date-tab {\n  background: transparent;\n  border: 0;\n  border-bottom: 1px solid transparent;\n  color: var(--taupe);\n  cursor: default;\n  flex: 0 0 auto;\n  font-family: 'Inter', sans-serif;\n  font-size: 11px;\n  line-height: 1;\n  padding: 0 0 14px;\n  text-align: left;\n}\n\n#concept-board .date-tab .tab-date {\n  display: block;\n  font-family: 'Roboto Mono', monospace;\n  font-size: 10px;\n  line-height: 1.4;\n}\n\n#concept-board .date-tab .tab-day {\n  display: block;\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: -.01em;\n  margin-top: 6px;\n}\n\n#concept-board .date-tab.active {\n  border-bottom-color: var(--accent);\n  color: var(--ink);\n}\n\n#concept-board .date-tab.active .tab-day {\n  font-weight: 600;\n}\n\n#concept-board .timeline {\n  margin-top: 29px;\n}\n\n#concept-board .timeline-row {\n  display: grid;\n  grid-template-columns: 104px 28px minmax(0, 1fr);\n  min-height: 112px;\n}\n\n#concept-board .timeline-time {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 11px;\n  line-height: 1.5;\n  padding-top: 1px;\n  white-space: nowrap;\n}\n\n#concept-board .timeline-guide {\n  border-left: 1px dotted var(--taupe);\n  min-height: 100%;\n  position: relative;\n}\n\n#concept-board .timeline-row:last-child .timeline-guide::after {\n  border-left: 1px dotted var(--taupe);\n  bottom: -12px;\n  content: '';\n  height: 12px;\n  left: -1px;\n  position: absolute;\n}\n\n#concept-board .timeline-dot {\n  background: var(--accent);\n  border-radius: 999px;\n  height: 7px;\n  left: -4px;\n  position: absolute;\n  top: 2px;\n  width: 7px;\n}\n\n#concept-board .activity-row {\n  border-bottom: 1px solid var(--line);\n  display: flex;\n  gap: 18px;\n  justify-content: space-between;\n  margin-left: 17px;\n  min-width: 0;\n  padding: 0 0 24px;\n}\n\n#concept-board .activity-copy {\n  min-width: 0;\n}\n\n#concept-board .activity-index {\n  color: var(--accent);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  line-height: 1.6;\n  padding-top: 2px;\n}\n\n#concept-board .activity-title {\n  font-size: 15px;\n  font-weight: 600;\n  letter-spacing: -.02em;\n  line-height: 1.45;\n}\n\n#concept-board .activity-location {\n  align-items: center;\n  color: var(--taupe);\n  display: flex;\n  font-size: 11px;\n  gap: 5px;\n  line-height: 1.5;\n  margin-top: 8px;\n}\n\n#concept-board .activity-arrow {\n  color: var(--taupe);\n  font-size: 16px;\n  line-height: 1;\n  padding-top: 2px;\n}\n\n#concept-board .budget-panel {\n  border-left: 1px solid var(--line);\n  min-width: 0;\n  padding-left: 36px;\n}\n\n#concept-board .budget-heading {\n  align-items: start;\n  display: flex;\n  justify-content: space-between;\n}\n\n#concept-board .budget-heading h3 {\n  font-size: 26px;\n  font-weight: 600;\n  letter-spacing: -.045em;\n  line-height: 1.2;\n  margin-top: 9px;\n}\n\n#concept-board .budget-heading .wallet-icon {\n  color: var(--accent);\n  font-size: 20px;\n  padding-top: 3px;\n}\n\n#concept-board .budget-metrics {\n  border-bottom: 1px solid var(--line);\n  border-top: 1px solid var(--line);\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  margin-top: 25px;\n  padding: 17px 0 18px;\n}\n\n#concept-board .budget-metric {\n  border-right: 1px solid var(--line);\n  min-width: 0;\n  padding: 0 16px;\n}\n\n#concept-board .budget-metric:first-child {\n  padding-left: 0;\n}\n\n#concept-board .budget-metric:last-child {\n  border-right: 0;\n  padding-right: 0;\n}\n\n#concept-board .budget-metric-label {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 10px;\n  letter-spacing: .1em;\n  line-height: 1.4;\n}\n\n#concept-board .budget-number {\n  color: var(--ink);\n  font-family: 'Roboto Mono', monospace;\n  font-size: clamp(14px, 1.45vw, 20px);\n  letter-spacing: -.06em;\n  line-height: 1.4;\n  margin-top: 7px;\n  white-space: nowrap;\n}\n\n#concept-board .budget-metric:last-child .budget-number {\n  color: var(--accent);\n}\n\n#concept-board .progress-wrap {\n  border-bottom: 1px solid var(--line);\n  padding: 17px 0 21px;\n}\n\n#concept-board .progress-label {\n  align-items: center;\n  color: var(--taupe);\n  display: flex;\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  justify-content: space-between;\n  letter-spacing: .08em;\n  line-height: 1.4;\n}\n\n#concept-board .progress-track {\n  background: var(--line);\n  height: 4px;\n  margin-top: 10px;\n  width: 100%;\n}\n\n#concept-board .progress-fill {\n  background: var(--accent);\n  height: 4px;\n  width: 95%;\n}\n\n#concept-board .budget-table {\n  margin-top: 24px;\n}\n\n#concept-board .budget-table-row {\n  align-items: center;\n  border-bottom: 1px solid var(--line);\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 160px;\n  min-height: 38px;\n}\n\n#concept-board .budget-table-row span {\n  font-size: 11px;\n  line-height: 1.5;\n}\n\n#concept-board .budget-table-row .amount {\n  font-family: 'Roboto Mono', monospace;\n  text-align: right;\n  white-space: nowrap;\n}\n\n#concept-board .budget-table-row.table-head {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .1em;\n  min-height: 33px;\n  text-transform: uppercase;\n}\n\n#concept-board .budget-table-row.table-head span {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  letter-spacing: .1em;\n}\n\n#concept-board .budget-table-row.table-head span:first-child {\n  padding-left: 13px;\n}\n\n#concept-board .category-label {\n  align-items: center;\n  display: flex;\n  gap: 8px;\n}\n\n#concept-board .category-mark {\n  background: var(--accent);\n  display: inline-block;\n  height: 5px;\n  width: 5px;\n}\n\n#concept-board .category-share {\n  color: var(--taupe);\n  font-size: 9px;\n  margin-left: 8px;\n}\n\n#concept-board .expenses {\n  margin-top: 31px;\n}\n\n#concept-board .expenses-head {\n  align-items: center;\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 7px;\n}\n\n#concept-board .expenses-count {\n  color: var(--taupe);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 10px;\n  letter-spacing: .08em;\n}\n\n#concept-board .expense-row {\n  align-items: start;\n  border-bottom: 1px solid var(--line);\n  display: grid;\n  gap: 18px;\n  grid-template-columns: minmax(0, 1fr) 132px;\n  padding: 14px 0 13px;\n}\n\n#concept-board .expense-title {\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: -.01em;\n  line-height: 1.45;\n}\n\n#concept-board .expense-detail {\n  color: var(--taupe);\n  font-size: 9px;\n  line-height: 1.55;\n  margin-top: 5px;\n}\n\n#concept-board .expense-amount {\n  color: var(--ink);\n  font-family: 'Roboto Mono', monospace;\n  font-size: 11px;\n  line-height: 1.45;\n  text-align: right;\n  white-space: nowrap;\n}\n\n#concept-board .board-footer {\n  align-items: center;\n  border-top: 1px solid var(--line);\n  color: var(--taupe);\n  display: flex;\n  font-family: 'Roboto Mono', monospace;\n  font-size: 9px;\n  justify-content: space-between;\n  letter-spacing: .11em;\n  line-height: 1.6;\n  margin-top: 88px;\n  padding-top: 18px;\n  text-transform: uppercase;\n}\n\n@media (max-width: 900px) {\n  #concept-board {\n    padding: 22px 24px 38px;\n  }\n\n  #concept-board .board-header {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 15px;\n    padding-bottom: 17px;\n  }\n\n  #concept-board .quiet-nav {\n    gap: 16px;\n    overflow-x: auto;\n    width: 100%;\n  }\n\n  #concept-board .board-masthead {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 23px;\n    min-height: 0;\n    padding: 33px 0 27px;\n  }\n\n  #concept-board .masthead-note {\n    text-align: left;\n  }\n\n  #concept-board .section-heading {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 18px;\n  }\n\n  #concept-board .section-heading .descriptor {\n    text-align: left;\n  }\n\n  #concept-board .dossier-table {\n    overflow-x: visible;\n  }\n\n  #concept-board .dossier-table-head {\n    display: none;\n  }\n\n  #concept-board .dossier-table-row {\n    display: block;\n    min-width: 0;\n    padding: 19px 18px 22px 15px;\n  }\n\n  #concept-board .dossier-table-row > div {\n    padding: 11px 0;\n  }\n\n  #concept-board .dossier-table-row > div:not(:first-child) {\n    border-top: 1px solid var(--line);\n  }\n\n  #concept-board .dossier-table-row > div:nth-child(2)::before,\n  #concept-board .dossier-table-row > div:nth-child(3)::before,\n  #concept-board .dossier-table-row > div:nth-child(4)::before,\n  #concept-board .dossier-table-row > div:nth-child(5)::before {\n    color: var(--taupe);\n    content: '';\n    display: block;\n    font-family: 'Roboto Mono', monospace;\n    font-size: 9px;\n    letter-spacing: .12em;\n    line-height: 1.4;\n    margin-bottom: 6px;\n    text-transform: uppercase;\n  }\n\n  #concept-board .dossier-table-row > div:nth-child(2)::before {\n    content: 'DESTINATION';\n  }\n\n  #concept-board .dossier-table-row > div:nth-child(3)::before {\n    content: 'DATES';\n  }\n\n  #concept-board .dossier-table-row > div:nth-child(4)::before {\n    content: 'TRAVELERS';\n  }\n\n  #concept-board .dossier-table-row > div:nth-child(5)::before {\n    content: 'STATUS';\n  }\n\n  #concept-board .dossier-table-row > div:nth-child(5) {\n    align-items: center;\n    display: grid;\n    grid-template-columns: 1fr auto auto;\n  }\n\n  #concept-board .dossier-table-row > div:nth-child(5)::before {\n    margin-bottom: 0;\n  }\n\n  #concept-board .overview-head {\n    gap: 28px;\n    grid-template-columns: 1fr;\n  }\n\n  #concept-board .fact-column {\n    border-left: 0;\n    border-top: 1px solid var(--line);\n    display: grid;\n    gap: 20px;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    padding-left: 0;\n    padding-top: 20px;\n  }\n\n  #concept-board .fact-row {\n    border-bottom: 0;\n    margin-bottom: 0;\n    padding-bottom: 0;\n  }\n\n  #concept-board .overview-split {\n    gap: 38px;\n    grid-template-columns: 1fr;\n  }\n\n  #concept-board .overview-aside {\n    border-left: 0;\n    border-top: 1px solid var(--line);\n    padding-left: 0;\n    padding-top: 28px;\n  }\n\n  #concept-board .planning-layout {\n    gap: 44px;\n    grid-template-columns: 1fr;\n  }\n\n  #concept-board .budget-panel {\n    border-left: 0;\n    border-top: 1px solid var(--line);\n    padding-left: 0;\n    padding-top: 32px;\n  }\n\n  #concept-board .board-footer {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 10px;\n  }\n}\n\n@media (max-width: 620px) {\n  #concept-board .board-masthead h1 {\n    font-size: 28px;\n  }\n\n  #concept-board .section-heading h2 {\n    font-size: 29px;\n  }\n\n  #concept-board .fact-column {\n    grid-template-columns: 1fr;\n  }\n\n  #concept-board .highlight-list {\n    grid-template-columns: 1fr;\n  }\n\n  #concept-board .highlight-item:nth-child(odd) {\n    border-right: 0;\n    padding-right: 0;\n  }\n\n  #concept-board .highlight-item:nth-child(even) {\n    padding-left: 0;\n  }\n\n  #concept-board .highlight-item:nth-child(-n+2) {\n    border-top: 0;\n  }\n\n  #concept-board .highlight-item:first-child {\n    border-top: 1px solid var(--line);\n  }\n\n  #concept-board .gallery-grid {\n    grid-template-columns: 1fr;\n  }\n\n  #concept-board .gallery-image-shell {\n    height: 190px;\n  }\n\n  #concept-board .timeline-row {\n    grid-template-columns: 86px 24px minmax(0, 1fr);\n  }\n\n  #concept-board .activity-row {\n    gap: 10px;\n    margin-left: 12px;\n  }\n\n  #concept-board .budget-metric {\n    padding-left: 9px;\n    padding-right: 9px;\n  }\n\n  #concept-board .budget-number {\n    font-size: 12px;\n    letter-spacing: -.08em;\n  }\n\n  #concept-board .expense-row {\n    grid-template-columns: minmax(0, 1fr) 110px;\n  }\n}\n</style>\n<main class=\"min-h-screen\" data-kid=\"1\" data-name=\"concept board layout container\" id=\"concept-board\">\n    <header class=\"board-header flex items-center justify-between gap-8\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand identity container\">\n            <span aria-hidden=\"true\" class=\"brand-rule text-[16px]\" data-kid=\"1-1-1-1\" data-name=\"compass icon\">\n                <i class=\"ti ti-compass\" data-kid=\"1-1-1-1-1\" data-name=\"compass icon glyph\">\n                </i>\n            </span>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand name and subtitle container\">\n                <div class=\"text-[14px] font-semibold tracking-[-.03em]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    Pack to Go\n                </div>\n                <div class=\"mono mt-1 text-[9px] tracking-[.08em] text-[var(--taupe)]\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle text\">\n                    SHARED TRIP PLANNING\n                </div>\n            </div>\n        </div>\n        <nav aria-label=\"Concept navigation\" class=\"quiet-nav flex items-center gap-7\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n            <span data-kid=\"1-1-2-1\" data-name=\"my trips navigation link\">\n                MY TRIPS\n            </span>\n            <span data-kid=\"1-1-2-2\" data-name=\"trip dossier navigation link\">\n                TRIP DOSSIER\n            </span>\n            <span data-kid=\"1-1-2-3\" data-name=\"log out navigation link\">\n                LOG OUT\n            </span>\n        </nav>\n    </header>\n    <div class=\"board-masthead flex items-end justify-between gap-8\" data-kid=\"1-2\" data-name=\"masthead section\">\n        <div data-kid=\"1-2-1\" data-name=\"page title container\">\n            <p class=\"eyebrow\" data-kid=\"1-2-1-1\" data-name=\"page eyebrow label\">\n                UI CONCEPT BOARD / TRAVEL COLLABORATION\n            </p>\n            <h1 class=\"mt-4\" data-kid=\"1-2-1-2\" data-name=\"page headline\">\n                02 · Minimal Premium Travel Dossier\n            </h1>\n        </div>\n        <div class=\"masthead-note\" data-kid=\"1-2-2\" data-name=\"masthead note container\">\n            WARM PAPER / HAIRLINE RULES\n            <br data-kid=\"1-2-2-1\" data-name=\"line break\"/>\n            3 SCREEN PREVIEWS / 1440 DESKTOP\n        </div>\n    </div>\n    <section aria-labelledby=\"screen-one-title\" class=\"screen-section screen-one pt-14\" data-kid=\"1-3\" data-name=\"my trips section\">\n        <div class=\"section-heading\" data-kid=\"1-3-1\" data-name=\"section heading container\">\n            <div data-kid=\"1-3-1-1\" data-name=\"section title group\">\n                <p class=\"eyebrow\" data-kid=\"1-3-1-1-1\" data-name=\"section eyebrow\">\n                    SCREEN 01\n                    <span class=\"mx-1 text-[var(--taupe)]\" data-kid=\"1-3-1-1-1-1\" data-name=\"separator icon\">\n                        /\n                    </span>\n                    MY TRIPS\n                </p>\n                <div class=\"mt-3 flex flex-wrap items-end gap-x-6 gap-y-2\" data-kid=\"1-3-1-1-2\" data-name=\"heading and description container\">\n                    <h2 data-kid=\"1-3-1-1-2-1\" data-name=\"section heading\" id=\"screen-one-title\">\n                        여행 기록\n                    </h2>\n                    <p class=\"descriptor pb-1\" data-kid=\"1-3-1-1-2-2\" data-name=\"section descriptor\">\n                        TRIP DISCOVERY / LIST VIEW\n                    </p>\n                </div>\n                <p class=\"section-caption mt-3\" data-kid=\"1-3-1-1-3\" data-name=\"section caption\">\n                    함께 계획한 여정을 한눈에 정리합니다.\n                </p>\n            </div>\n            <p class=\"descriptor\" data-kid=\"1-3-1-2\" data-name=\"secondary section descriptor\">\n                01\n                <span class=\"mx-2 text-[var(--line)]\" data-kid=\"1-3-1-2-1\" data-name=\"separator icon\">\n                    /\n                </span>\n                ACTIVE DOSSIER\n            </p>\n        </div>\n        <div aria-label=\"My trips dossier list\" class=\"dossier-table mt-10\" data-kid=\"1-3-2\" data-name=\"dossier table\" role=\"table\">\n            <div class=\"dossier-table-head\" data-kid=\"1-3-2-1\" data-name=\"table header row\" role=\"row\">\n                <div data-kid=\"1-3-2-1-1\" data-name=\"dossier column header\" role=\"columnheader\">\n                    DOSSIER\n                </div>\n                <div data-kid=\"1-3-2-1-2\" data-name=\"destination column header\" role=\"columnheader\">\n                    DESTINATION\n                </div>\n                <div data-kid=\"1-3-2-1-3\" data-name=\"dates column header\" role=\"columnheader\">\n                    DATES\n                </div>\n                <div data-kid=\"1-3-2-1-4\" data-name=\"travelers column header\" role=\"columnheader\">\n                    TRAVELERS\n                </div>\n                <div class=\"text-right\" data-kid=\"1-3-2-1-5\" data-name=\"status column header\" role=\"columnheader\">\n                    STATUS\n                </div>\n            </div>\n            <div class=\"dossier-table-row\" data-kid=\"1-3-2-2\" data-name=\"table row\" role=\"row\">\n                <div class=\"trip-primary\" data-kid=\"1-3-2-2-1\" data-name=\"trip primary information cell\" role=\"cell\">\n                    <img alt=\"Minimalist landscape — Daniel Romero on Unsplash\" class=\"trip-thumb\" data-kid=\"1-3-2-2-1-1\" data-name=\"trip thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1746038040789-20ebc794ed12?auto=format&w=420&q=80&fit=crop\"/>\n                    <div data-kid=\"1-3-2-2-1-2\" data-name=\"trip title and metadata container\">\n                        <p class=\"trip-title\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"trip title\">\n                            40대의 마지막 오키나와\n                        </p>\n                        <p class=\"trip-meta\" data-kid=\"1-3-2-2-1-2-2\" data-name=\"trip metadata\">\n                            TRIP DOSSIER\n                            <span class=\"mx-1\" data-kid=\"1-3-2-2-1-2-2-1\" data-name=\"separator\">\n                                /\n                            </span>\n                            01\n                        </p>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-2-2-2\" data-name=\"destination cell\" role=\"cell\">\n                    <p class=\"dossier-value\" data-kid=\"1-3-2-2-2-1\" data-name=\"destination name with pin\">\n                        <span class=\"mr-2 text-[14px] text-[var(--accent)]\" data-kid=\"1-3-2-2-2-1-1\" data-name=\"map pin icon\">\n                            <i class=\"ti ti-map-pin\" data-kid=\"1-3-2-2-2-1-1-1\" data-name=\"map pin glyph\">\n                            </i>\n                        </span>\n                        오키나와 (나하 & 차탄)\n                    </p>\n                    <p class=\"dossier-subvalue\" data-kid=\"1-3-2-2-2-2\" data-name=\"destination coordinates\">\n                        26° 12′ N / 127° 41′ E\n                    </p>\n                </div>\n                <div data-kid=\"1-3-2-2-3\" data-name=\"dates cell\" role=\"cell\">\n                    <p class=\"dossier-value mono\" data-kid=\"1-3-2-2-3-1\" data-name=\"dates value with calendar\">\n                        <span class=\"mr-2 text-[13px] text-[var(--accent)]\" data-kid=\"1-3-2-2-3-1-1\" data-name=\"calendar icon\">\n                            <i class=\"ti ti-calendar\" data-kid=\"1-3-2-2-3-1-1-1\" data-name=\"calendar glyph\">\n                            </i>\n                        </span>\n                        2027.09.17 — 2027.09.21\n                    </p>\n                </div>\n                <div data-kid=\"1-3-2-2-4\" data-name=\"travelers cell\" role=\"cell\">\n                    <p class=\"dossier-value\" data-kid=\"1-3-2-2-4-1\" data-name=\"travelers value with icon\">\n                        <span class=\"mr-2 text-[14px] text-[var(--accent)]\" data-kid=\"1-3-2-2-4-1-1\" data-name=\"users icon\">\n                            <i class=\"ti ti-users\" data-kid=\"1-3-2-2-4-1-1-1\" data-name=\"users glyph\">\n                            </i>\n                        </span>\n                        영숙\n                        <span class=\"text-[var(--taupe)]\" data-kid=\"1-3-2-2-4-1-2\" data-name=\"bullet separator\">\n                            ·\n                        </span>\n                        Dev User\n                    </p>\n                </div>\n                <div class=\"status-cell\" data-kid=\"1-3-2-2-5\" data-name=\"status cell\" role=\"cell\">\n                    <span class=\"status mono\" data-kid=\"1-3-2-2-5-1\" data-name=\"status label\">\n                        D-393\n                    </span>\n                    <span class=\"text-[15px] text-[var(--accent)]\" data-kid=\"1-3-2-2-5-2\" data-name=\"status chevron icon\">\n                        <i class=\"ti ti-chevron-right\" data-kid=\"1-3-2-2-5-2-1\" data-name=\"chevron glyph\">\n                        </i>\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"screen-two-title\" class=\"screen-section screen-two\" data-kid=\"1-4\" data-name=\"trip dossier section\">\n        <div class=\"section-heading\" data-kid=\"1-4-1\" data-name=\"section heading container\">\n            <div data-kid=\"1-4-1-1\" data-name=\"section eyebrow group\">\n                <p class=\"eyebrow\" data-kid=\"1-4-1-1-1\" data-name=\"section eyebrow\">\n                    SCREEN 02\n                    <span class=\"mx-1 text-[var(--taupe)]\" data-kid=\"1-4-1-1-1-1\" data-name=\"separator icon\">\n                        /\n                    </span>\n                    TRIP DOSSIER\n                </p>\n                <p class=\"section-caption mt-3\" data-kid=\"1-4-1-1-2\" data-name=\"section caption\">\n                    여행지의 결, 함께 정한 장면, 그리고 다음 페이지의 단서.\n                </p>\n            </div>\n            <p class=\"descriptor\" data-kid=\"1-4-1-2\" data-name=\"section descriptor\">\n                02\n                <span class=\"mx-2 text-[var(--line)]\" data-kid=\"1-4-1-2-1\" data-name=\"separator icon\">\n                    /\n                </span>\n                TRIP OVERVIEW\n            </p>\n        </div>\n        <div class=\"overview-head mt-8\" data-kid=\"1-4-2\" data-name=\"overview head container\">\n            <div data-kid=\"1-4-2-1\" data-name=\"title and description container\">\n                <h2 class=\"overview-title\" data-kid=\"1-4-2-1-1\" data-name=\"overview title\" id=\"screen-two-title\">\n                    40대의 마지막 오키나와\n                </h2>\n                <p class=\"concept-line\" data-kid=\"1-4-2-1-2\" data-name=\"overview description\">\n                    “맛있는 일본 여행, 잔잔한 파도소리, 그리고 오키나와의 여유”\n                </p>\n            </div>\n            <dl class=\"fact-column\" data-kid=\"1-4-2-2\" data-name=\"fact list\">\n                <div class=\"fact-row\" data-kid=\"1-4-2-2-1\" data-name=\"date fact row\">\n                    <dt data-kid=\"1-4-2-2-1-1\" data-name=\"fact label\">\n                        DATES\n                    </dt>\n                    <dd class=\"mono\" data-kid=\"1-4-2-2-1-2\" data-name=\"fact value\">\n                        2027.09.17 — 2027.09.21\n                    </dd>\n                </div>\n                <div class=\"fact-row\" data-kid=\"1-4-2-2-2\" data-name=\"destination fact row\">\n                    <dt data-kid=\"1-4-2-2-2-1\" data-name=\"fact label\">\n                        DESTINATION\n                    </dt>\n                    <dd data-kid=\"1-4-2-2-2-2\" data-name=\"fact value\">\n                        오키나와 (나하 & 차탄)\n                    </dd>\n                </div>\n                <div class=\"fact-row\" data-kid=\"1-4-2-2-3\" data-name=\"members fact row\">\n                    <dt data-kid=\"1-4-2-2-3-1\" data-name=\"fact label\">\n                        MEMBERS\n                    </dt>\n                    <dd data-kid=\"1-4-2-2-3-2\" data-name=\"fact value\">\n                        <span class=\"mr-1 text-[13px] text-[var(--accent)]\" data-kid=\"1-4-2-2-3-2-1\" data-name=\"users icon\">\n                            <i class=\"ti ti-users\" data-kid=\"1-4-2-2-3-2-1-1\" data-name=\"users glyph\">\n                            </i>\n                        </span>\n                        영숙 · Dev User\n                        <span class=\"mono ml-1 text-[10px] text-[var(--taupe)]\" data-kid=\"1-4-2-2-3-2-2\" data-name=\"member count\">\n                            02\n                        </span>\n                    </dd>\n                </div>\n            </dl>\n        </div>\n        <figure class=\"destination-figure\" data-kid=\"1-4-3\" data-name=\"destination figure\">\n            <img alt=\"Okinawa destination gallery\" class=\"destination-image\" data-kid=\"1-4-3-1\" data-name=\"destination image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/gallery/1.jpg\"/>\n            <figcaption class=\"image-caption\" data-kid=\"1-4-3-2\" data-name=\"image caption container\">\n                <span data-kid=\"1-4-3-2-1\" data-name=\"destination text\">\n                    DESTINATION / Chatan, Okinawa\n                </span>\n                <span data-kid=\"1-4-3-2-2\" data-name=\"highlights count text\">\n                    01 / 04 HIGHLIGHTS\n                </span>\n            </figcaption>\n        </figure>\n        <div class=\"overview-split\" data-kid=\"1-4-4\" data-name=\"overview split container\">\n            <div data-kid=\"1-4-4-1\" data-name=\"narrative content container\">\n                <p class=\"eyebrow\" data-kid=\"1-4-4-1-1\" data-name=\"narrative eyebrow\">\n                    THE PLACE\n                    <span class=\"mx-1 text-[var(--taupe)]\" data-kid=\"1-4-4-1-1-1\" data-name=\"separator\">\n                        /\n                    </span>\n                    EDITORIAL NOTE\n                </p>\n                <h3 class=\"narrative-title mt-3\" data-kid=\"1-4-4-1-2\" data-name=\"narrative title\">\n                    천천히, 오키나와를 읽는 시간\n                </h3>\n                <p class=\"narrative-copy\" data-kid=\"1-4-4-1-3\" data-name=\"narrative body copy\">\n                    섬의 결을 따라 걷고, 바다의 색을 오래 바라보며 함께 계획한 여정을 채웁니다. 네 가지 장면을 중심으로 나하와 차탄 사이의 온도를 기록합니다.\n                </p>\n                <div aria-label=\"Okinawa highlights\" class=\"highlight-list\" data-kid=\"1-4-4-1-4\" data-name=\"highlights list\">\n                    <div class=\"highlight-item\" data-kid=\"1-4-4-1-4-1\" data-name=\"highlight item 1\">\n                        <span class=\"highlight-number\" data-kid=\"1-4-4-1-4-1-1\" data-name=\"highlight number\">\n                            01\n                        </span>\n                        <div class=\"highlight-copy\" data-kid=\"1-4-4-1-4-1-2\" data-name=\"highlight copy\">\n                            <h4 data-kid=\"1-4-4-1-4-1-2-1\" data-name=\"highlight title\">\n                                에메랄드빛 아열대 낙원\n                                <span class=\"highlight-check text-[12px]\" data-kid=\"1-4-4-1-4-1-2-1-1\" data-name=\"checkmark icon\">\n                                    <i class=\"ti ti-check\" data-kid=\"1-4-4-1-4-1-2-1-1-1\" data-name=\"checkmark glyph\">\n                                    </i>\n                                </span>\n                            </h4>\n                            <p data-kid=\"1-4-4-1-4-1-2-2\" data-name=\"highlight text\">\n                                일본 최남단에 위치한 아열대 기후의 섬으로, 에메랄드빛 바다와 산호초가 펼쳐진 아름다운 자연 경관을 자랑합니다.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"highlight-item\" data-kid=\"1-4-4-1-4-2\" data-name=\"highlight item 2\">\n                        <span class=\"highlight-number\" data-kid=\"1-4-4-1-4-2-1\" data-name=\"highlight number\">\n                            02\n                        </span>\n                        <div class=\"highlight-copy\" data-kid=\"1-4-4-1-4-2-2\" data-name=\"highlight copy\">\n                            <h4 data-kid=\"1-4-4-1-4-2-2-1\" data-name=\"highlight title\">\n                                독자적인 류큐 왕국의 숨결\n                                <span class=\"highlight-check text-[12px]\" data-kid=\"1-4-4-1-4-2-2-1-1\" data-name=\"checkmark icon\">\n                                    <i class=\"ti ti-check\" data-kid=\"1-4-4-1-4-2-2-1-1-1\" data-name=\"checkmark glyph\">\n                                    </i>\n                                </span>\n                            </h4>\n                            <p data-kid=\"1-4-4-1-4-2-2-2\" data-name=\"highlight text\">\n                                과거 류큐 왕국 시대의 독자적인 역사와 문화를 간직하고 있어, 일본 본토와는 다른 이국적이고 매력적인 분위기를 느낄 수 있습니다.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"highlight-item\" data-kid=\"1-4-4-1-4-3\" data-name=\"highlight item 3\">\n                        <span class=\"highlight-number\" data-kid=\"1-4-4-1-4-3-1\" data-name=\"highlight number\">\n                            03\n                        </span>\n                        <div class=\"highlight-copy\" data-kid=\"1-4-4-1-4-3-2\" data-name=\"highlight copy\">\n                            <h4 data-kid=\"1-4-4-1-4-3-2-1\" data-name=\"highlight title\">\n                                동서양이 만나는 문화 융합\n                                <span class=\"highlight-check text-[12px]\" data-kid=\"1-4-4-1-4-3-2-1-1\" data-name=\"checkmark icon\">\n                                    <i class=\"ti ti-check\" data-kid=\"1-4-4-1-4-3-2-1-1-1\" data-name=\"checkmark glyph\">\n                                    </i>\n                                </span>\n                            </h4>\n                            <p data-kid=\"1-4-4-1-4-3-2-2\" data-name=\"highlight text\">\n                                미군의 영향으로 형성된 아메리칸 빌리지 등 독특한 사회적 융합 문화가 곳곳에 스며들어 색다른 볼거리를 제공합니다.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"highlight-item\" data-kid=\"1-4-4-1-4-4\" data-name=\"highlight item 4\">\n                        <span class=\"highlight-number\" data-kid=\"1-4-4-1-4-4-1\" data-name=\"highlight number\">\n                            04\n                        </span>\n                        <div class=\"highlight-copy\" data-kid=\"1-4-4-1-4-4-2\" data-name=\"highlight copy\">\n                            <h4 data-kid=\"1-4-4-1-4-4-2-1\" data-name=\"highlight title\">\n                                사계절 내내 완벽한 휴양\n                                <span class=\"highlight-check text-[12px]\" data-kid=\"1-4-4-1-4-4-2-1-1\" data-name=\"checkmark icon\">\n                                    <i class=\"ti ti-check\" data-kid=\"1-4-4-1-4-4-2-1-1-1\" data-name=\"checkmark glyph\">\n                                    </i>\n                                </span>\n                            </h4>\n                            <p data-kid=\"1-4-4-1-4-4-2-2\" data-name=\"highlight text\">\n                                세계적인 수준의 다이빙 포인트와 따뜻한 날씨 덕분에 해양 스포츠와 휴양을 즐기기에 최적의 조건을 갖추고 있습니다.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <aside aria-label=\"Destination notes\" class=\"overview-aside\" data-kid=\"1-4-4-2\" data-name=\"overview aside container\">\n                <div class=\"map-placeholder\" data-kid=\"1-4-4-2-1\" data-name=\"map placeholder\">\n                    <p class=\"map-label\" data-kid=\"1-4-4-2-1-1\" data-name=\"map label\">\n                        Chatan, Okinawa / MAP\n                    </p>\n                    <svg aria-hidden=\"true\" class=\"map-path\" data-kid=\"1-4-4-2-1-2\" data-name=\"map path graphic\" preserveaspectratio=\"none\" viewbox=\"0 0 360 180\">\n                        <path d=\"M 40 138 C 72 119, 91 145, 123 119 S 172 92, 203 79 S 232 70, 218 76\">\n                        </path>\n                        <path d=\"M 218 76 C 194 55, 171 45, 142 38\">\n                        </path>\n                        <path d=\"M 218 76 C 247 86, 270 107, 296 111\">\n                        </path>\n                    </svg>\n                    <span aria-hidden=\"true\" class=\"map-marker text-[14px]\" data-kid=\"1-4-4-2-1-3\" data-name=\"map marker\">\n                        <i class=\"ti ti-map-pin\" data-kid=\"1-4-4-2-1-3-1\" data-name=\"map marker glyph\">\n                        </i>\n                    </span>\n                    <span class=\"map-coordinate\" data-kid=\"1-4-4-2-1-4\" data-name=\"map coordinate text\">\n                        26° 19′ N / 127° 45′ E\n                    </span>\n                </div>\n                <dl class=\"aside-rows\" data-kid=\"1-4-4-2-2\" data-name=\"aside information list\">\n                    <div class=\"aside-row\" data-kid=\"1-4-4-2-2-1\" data-name=\"aside date row\">\n                        <dt data-kid=\"1-4-4-2-2-1-1\" data-name=\"aside label\">\n                            <span class=\"mr-1 text-[12px]\" data-kid=\"1-4-4-2-2-1-1-1\" data-name=\"calendar icon\">\n                                <i class=\"ti ti-calendar\" data-kid=\"1-4-4-2-2-1-1-1-1\" data-name=\"calendar glyph\">\n                                </i>\n                            </span>\n                            DOSSIER DATES\n                        </dt>\n                        <dd class=\"mono\" data-kid=\"1-4-4-2-2-1-2\" data-name=\"aside value\">\n                            17 — 21 SEP 2027\n                        </dd>\n                    </div>\n                    <div class=\"aside-row\" data-kid=\"1-4-4-2-2-2\" data-name=\"aside weather row\">\n                        <dt data-kid=\"1-4-4-2-2-2-1\" data-name=\"aside label\">\n                            예상 날씨\n                        </dt>\n                        <dd data-kid=\"1-4-4-2-2-2-2\" data-name=\"aside value\">\n                            평균 기온 20도, 맑고 화창한 봄 날씨\n                            <span class=\"text-[var(--taupe)]\" data-kid=\"1-4-4-2-2-2-2-1\" data-name=\"weather note\">\n                                (가끔 흐림)\n                            </span>\n                        </dd>\n                    </div>\n                    <div class=\"aside-row\" data-kid=\"1-4-4-2-2-3\" data-name=\"aside clothing row\">\n                        <dt data-kid=\"1-4-4-2-2-3-1\" data-name=\"aside label\">\n                            추천 복장\n                        </dt>\n                        <dd data-kid=\"1-4-4-2-2-3-2\" data-name=\"aside value\">\n                            초가을의 선선한 바람이 부는 날씨. 반팔 위주의 가벼운 옷차림과 저녁을 위한 가벼운 외투\n                        </dd>\n                    </div>\n                </dl>\n            </aside>\n        </div>\n        <div class=\"gallery-strip\" data-kid=\"1-4-5\" data-name=\"gallery strip\">\n            <div class=\"gallery-head\" data-kid=\"1-4-5-1\" data-name=\"gallery heading\">\n                <p class=\"eyebrow\" data-kid=\"1-4-5-1-1\" data-name=\"gallery eyebrow\">\n                    GALLERY\n                    <span class=\"mx-1 text-[var(--taupe)]\" data-kid=\"1-4-5-1-1-1\" data-name=\"separator\">\n                        /\n                    </span>\n                    03 FRAGMENTS\n                </p>\n                <p class=\"descriptor\" data-kid=\"1-4-5-1-2\" data-name=\"gallery descriptor\">\n                    A QUIET SEQUENCE OF PLACE\n                </p>\n            </div>\n            <div class=\"gallery-grid\" data-kid=\"1-4-5-2\" data-name=\"gallery grid\">\n                <figure class=\"gallery-item\" data-kid=\"1-4-5-2-1\" data-name=\"gallery item 1\">\n                    <div class=\"gallery-image-shell\" data-kid=\"1-4-5-2-1-1\" data-name=\"image shell\">\n                        <img alt=\"Okinawa gallery detail — shoreline and light\" data-kid=\"1-4-5-2-1-1-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/gallery/2.png\"/>\n                    </div>\n                    <figcaption data-kid=\"1-4-5-2-1-2\" data-name=\"gallery caption\">\n                        01 / SHORELINE & LIGHT\n                    </figcaption>\n                </figure>\n                <figure class=\"gallery-item\" data-kid=\"1-4-5-2-2\" data-name=\"gallery item 2\">\n                    <div class=\"gallery-image-shell\" data-kid=\"1-4-5-2-2-1\" data-name=\"image shell\">\n                        <img alt=\"Okinawa gallery detail — island texture\" data-kid=\"1-4-5-2-2-1-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/gallery/3.jpg\"/>\n                    </div>\n                    <figcaption data-kid=\"1-4-5-2-2-2\" data-name=\"gallery caption\">\n                        02 / ISLAND TEXTURE\n                    </figcaption>\n                </figure>\n                <figure class=\"gallery-item\" data-kid=\"1-4-5-2-3\" data-name=\"gallery item 3\">\n                    <div class=\"gallery-image-shell\" data-kid=\"1-4-5-2-3-1\" data-name=\"image shell\">\n                        <img alt=\"Okinawa gallery detail — evening coast\" data-kid=\"1-4-5-2-3-1-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/gallery/4.jpg\"/>\n                    </div>\n                    <figcaption data-kid=\"1-4-5-2-3-2\" data-name=\"gallery caption\">\n                        03 / EVENING COAST\n                    </figcaption>\n                </figure>\n            </div>\n        </div>\n    </section>\n    <section aria-labelledby=\"screen-three-title\" class=\"screen-section screen-three\" data-kid=\"1-5\" data-name=\"itinerary and budget section\">\n        <div class=\"section-heading\" data-kid=\"1-5-1\" data-name=\"section heading container\">\n            <div data-kid=\"1-5-1-1\" data-name=\"section title group\">\n                <p class=\"eyebrow\" data-kid=\"1-5-1-1-1\" data-name=\"section eyebrow\">\n                    SCREEN 03\n                    <span class=\"mx-1 text-[var(--taupe)]\" data-kid=\"1-5-1-1-1-1\" data-name=\"separator\">\n                        /\n                    </span>\n                    ITINERARY + BUDGET\n                </p>\n                <h2 class=\"mt-3\" data-kid=\"1-5-1-1-2\" data-name=\"section heading\" id=\"screen-three-title\">\n                    하루의 결을 따라, 숫자를 맞추다\n                </h2>\n            </div>\n            <p class=\"descriptor\" data-kid=\"1-5-1-2\" data-name=\"section descriptor\">\n                03\n                <span class=\"mx-2 text-[var(--line)]\" data-kid=\"1-5-1-2-1\" data-name=\"separator\">\n                    /\n                </span>\n                INFORMATION DOSSIER\n            </p>\n        </div>\n        <div class=\"planning-layout\" data-kid=\"1-5-2\" data-name=\"planning layout container\">\n            <section aria-label=\"Itinerary\" data-kid=\"1-5-2-1\" data-name=\"itinerary container\">\n                <div aria-label=\"Trip days\" class=\"date-tabs\" data-kid=\"1-5-2-1-1\" data-name=\"date tab list\" role=\"tablist\">\n                    <button aria-selected=\"true\" class=\"date-tab active\" data-kid=\"1-5-2-1-1-1\" data-name=\"day 1 button\" role=\"tab\" type=\"button\">\n                        <span class=\"tab-date\" data-kid=\"1-5-2-1-1-1-1\" data-name=\"day 1 date\">\n                            9.17 (금)\n                        </span>\n                        <span class=\"tab-day\" data-kid=\"1-5-2-1-1-1-2\" data-name=\"day 1 label\">\n                            DAY 01\n                        </span>\n                    </button>\n                    <button aria-selected=\"false\" class=\"date-tab\" data-kid=\"1-5-2-1-1-2\" data-name=\"day 2 button\" role=\"tab\" type=\"button\">\n                        <span class=\"tab-date\" data-kid=\"1-5-2-1-1-2-1\" data-name=\"day 2 date\">\n                            9.18 (토)\n                        </span>\n                        <span class=\"tab-day\" data-kid=\"1-5-2-1-1-2-2\" data-name=\"day 2 label\">\n                            DAY 02\n                        </span>\n                    </button>\n                    <button aria-selected=\"false\" class=\"date-tab\" data-kid=\"1-5-2-1-1-3\" data-name=\"day 3 button\" role=\"tab\" type=\"button\">\n                        <span class=\"tab-date\" data-kid=\"1-5-2-1-1-3-1\" data-name=\"day 3 date\">\n                            9.19 (일)\n                        </span>\n                        <span class=\"tab-day\" data-kid=\"1-5-2-1-1-3-2\" data-name=\"day 3 label\">\n                            DAY 03\n                        </span>\n                    </button>\n                    <button aria-selected=\"false\" class=\"date-tab\" data-kid=\"1-5-2-1-1-4\" data-name=\"day 4 button\" role=\"tab\" type=\"button\">\n                        <span class=\"tab-date\" data-kid=\"1-5-2-1-1-4-1\" data-name=\"day 4 date\">\n                            9.20 (월)\n                        </span>\n                        <span class=\"tab-day\" data-kid=\"1-5-2-1-1-4-2\" data-name=\"day 4 label\">\n                            DAY 04\n                        </span>\n                    </button>\n                </div>\n                <div class=\"timeline\" data-kid=\"1-5-2-1-2\" data-name=\"timeline container\">\n                    <div class=\"timeline-row\" data-kid=\"1-5-2-1-2-1\" data-name=\"timeline row 1\">\n                        <div class=\"timeline-time\" data-kid=\"1-5-2-1-2-1-1\" data-name=\"time label\">\n                            <span class=\"mr-1 text-[12px]\" data-kid=\"1-5-2-1-2-1-1-1\" data-name=\"clock icon\">\n                                <i class=\"ti ti-clock\" data-kid=\"1-5-2-1-2-1-1-1-1\" data-name=\"clock glyph\">\n                                </i>\n                            </span>\n                            11:00 AM\n                        </div>\n                        <div class=\"timeline-guide\" data-kid=\"1-5-2-1-2-1-2\" data-name=\"timeline guide\">\n                            <span class=\"timeline-dot\" data-kid=\"1-5-2-1-2-1-2-1\" data-name=\"timeline dot\">\n                            </span>\n                        </div>\n                        <div class=\"activity-row\" data-kid=\"1-5-2-1-2-1-3\" data-name=\"activity row\">\n                            <span class=\"activity-index\" data-kid=\"1-5-2-1-2-1-3-1\" data-name=\"activity index\">\n                                01\n                            </span>\n                            <div class=\"activity-copy\" data-kid=\"1-5-2-1-2-1-3-2\" data-name=\"activity copy\">\n                                <p class=\"activity-title\" data-kid=\"1-5-2-1-2-1-3-2-1\" data-name=\"activity title\">\n                                    오키나와 나하 공항 도착\n                                </p>\n                                <p class=\"activity-location\" data-kid=\"1-5-2-1-2-1-3-2-2\" data-name=\"activity location\">\n                                    <span class=\"text-[12px]\" data-kid=\"1-5-2-1-2-1-3-2-2-1\" data-name=\"location icon\">\n                                        <i class=\"ti ti-map-pin\" data-kid=\"1-5-2-1-2-1-3-2-2-1-1\" data-name=\"location glyph\">\n                                        </i>\n                                    </span>\n                                    나하 공항\n                                </p>\n                            </div>\n                            <span class=\"activity-arrow text-[16px]\" data-kid=\"1-5-2-1-2-1-3-3\" data-name=\"activity arrow icon\">\n                                <i class=\"ti ti-chevron-right\" data-kid=\"1-5-2-1-2-1-3-3-1\" dat